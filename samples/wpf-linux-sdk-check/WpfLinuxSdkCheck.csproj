<!--
  A consumer of the PACKAGED SDK. Deliberately minimal: the Sdk attribute is the whole integration,
  which is the point - it exercises what a real app outside this repo would use.

  Restore comes from artifacts/local-feed via the nuget.config beside this file, so `dotnet pack`
  (eng/build-sdk.sh without -p:SkipPack=true) must have run first.
-->
<Project Sdk="WpfWebGpu.Sdk/0.1.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WpfLinuxSdkCheck</AssemblyName>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
