<?xml version="1.0" encoding="utf-8"?>
<!-- The SDK package is produced locally, not published, so restore has to see artifacts/local-feed.
     clear first: the repo-root NuGet.config's feeds do not carry WpfWebGpu.Sdk and would only slow
     restore down looking for it. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local-feed" value="../../artifacts/local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
