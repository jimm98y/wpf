<!--
  An app whose own code P/Invokes user32 and kernel32, as Windows WPF apps do, built through the
  packaged SDK. On the browser head its P/Invokes are rewritten onto the stack's Windows API when it is
  published (Documentation/pinvoke-rewriter.md); it prints what each call answered ("pinvoke:" lines,
  on the console of whatever head runs it) and shows them in its window.

      dotnet publish -f net10.0 -p:WpfPlatform=browser     # WebAssembly
      dotnet build                                          # this machine's desktop head
-->
<Project Sdk="WpfWebGpu.Sdk/0.1.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>WpfPInvokeCheck</AssemblyName>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
