<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A cross-platform replacement for the Windows-only Microsoft.Web.WebView2.Wpf assembly, carrying
    the same strong-name identity so an application's existing PackageReference and XAML bind to it
    unchanged. See the Core project for why the public key is the real one and how that works.

    References the FORK's WPF by HintPath, exactly as the samples do: HwndHost lives in
    PresentationFramework, and this control has to derive from the same one the application will use.
    Run build.cmd first.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Microsoft.Web.WebView2.Wpf</AssemblyName>
    <RootNamespace>Microsoft.Web.WebView2.Wpf</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyVersion>1.0.4022.49</AssemblyVersion>
    <FileVersion>1.0.4022.49</FileVersion>
    <Version>1.0.4022.49</Version>

    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>../webview2.publickey</AssemblyOriginatorKeyFile>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1416;CS0067</NoWarn>

    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <_Wpf>$(MSBuildThisFileDirectory)../../../../../artifacts/bin</_Wpf>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Microsoft.Web.WebView2.Core/Microsoft.Web.WebView2.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationFramework"><HintPath>$(_Wpf)/PresentationFramework/Release/net10.0/PresentationFramework.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PresentationCore"><HintPath>$(_Wpf)/PresentationCore/Release/net10.0/PresentationCore.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WindowsBase"><HintPath>$(_Wpf)/WindowsBase/Release/net10.0/WindowsBase.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Xaml"><HintPath>$(_Wpf)/System.Xaml/Release/net10.0/System.Xaml.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
