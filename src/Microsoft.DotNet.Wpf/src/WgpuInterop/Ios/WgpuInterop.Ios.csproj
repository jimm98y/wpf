<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- iOS flavor of Microsoft.Wpf.Interop.WebGpu: same sources and assembly identity as
         ../WgpuInterop.csproj, but WGPU_IOS makes Wgpu.Library "__Internal" instead of
         "wgpu_native", because iOS cannot load a third-party dynamic library — wgpu-native is
         linked statically into the app executable.

         This flavor is REQUIRED; a runtime NativeLibrary.SetDllImportResolver mapping
         "wgpu_native" onto the main program handle is NOT enough. The static linker dead-strips
         every symbol nothing references at compile time, and a runtime resolver creates no such
         reference, so the imports simply vanish from the binary (observed: only 2 of ~43 _wgpu*
         symbols survived, then EntryPointNotFoundException at run time). A DllImport("__Internal")
         generates a P/Invoke stub that DOES reference the symbol, which is what keeps it alive.

         Plain net10.0 (not net10.0-ios): this is a pure binding with no UIKit dependency, and a
         net10.0 library is consumable from a net10.0-ios app. -->
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AssemblyName>Microsoft.Wpf.Interop.WebGpu</AssemblyName>
    <RootNamespace>Microsoft.Wpf.Interop.WebGpu</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DefineConstants>$(DefineConstants);WGPU_IOS</DefineConstants>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same sources as the desktop flavor, INCLUDING Wgpu.Native.cs (we want the real
         DllImports; only the library name differs). -->
    <Compile Include="..\**\*.cs"
             Exclude="..\tests\**;..\native\**;..\bin\**;..\obj\**;..\Browser\**;..\Ios\bin\**;..\Ios\obj\**" />
  </ItemGroup>

</Project>
