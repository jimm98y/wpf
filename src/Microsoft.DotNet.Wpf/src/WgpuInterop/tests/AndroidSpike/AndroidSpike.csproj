<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Android twin of tests/IosSpike: a minimal head that boots real WPF on the WebGPU compositor.

    Much SHORTER than the iOS one, and the differences are all consequences of one thing — Android
    can load a third-party shared library. So there is no static-link flavour of the binding
    (Wgpu.Library stays "wgpu_native", resolved to libwgpu_native.so out of the APK), no
    __Internal/dead-stripping problem, and no NativeReference/ForceLoad dance.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <!-- The shared binding's signatures use raw pointers (WGPUChainedStruct* etc.). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationId>net.dot.wpf.androidspike</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- WPF is full of [SupportedOSPlatform("windows")] API that no Android path reaches; this is a
         head, not a lint target. -->
    <NoWarn>$(NoWarn);CA1416;CS0618</NoWarn>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <_Art>../../../../../../artifacts/bin</_Art>
  </PropertyGroup>

  <!-- The Android windowing head (SurfaceView + Choreographer pump). Shared with
       samples/wpf-gallery-android rather than copied; see the file's own remarks. -->
  <ItemGroup>
    <Compile Include="../../../Shared/MS/Internal/Interop/AndroidHost.cs" Link="AndroidHost.cs" />
  </ItemGroup>

  <!-- The same fonts the iOS and browser heads bundle. Android's /system/fonts has no Segoe
       Fluent Icons / MDL2 substitute, so without Symbols.ttf every glyph icon renders as a box;
       Liberation/DejaVu additionally keep text metrics identical to the other heads.
       Copied out of the APK at startup by AndroidFonts.ExtractBundled. -->
  <ItemGroup>
    <AndroidAsset Include="../../../../../../sdk/WpfWebGpu.Fonts/fonts/*.ttf" Link="fonts/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The DESKTOP flavour of the binding: on Android a DllImport("wgpu_native") resolves through
       the normal loader to the libwgpu_native.so packed below, exactly as it does to a .dylib on
       macOS. Only iOS needs its own flavour. -->
  <ItemGroup>
    <ProjectReference Include="../../WgpuInterop.csproj" />
  </ItemGroup>

  <!-- wgpu-native, packed into the APK under lib/<abi>/. Fetch with eng/fetch-wgpu.ps1 -Rid
       android-arm64 (the tree is gitignored). arm64 only: every Android device made this decade is
       arm64, and so is the emulator on an Apple-silicon Mac. -->
  <ItemGroup>
    <AndroidNativeLibrary Include="../../native/android-arm64/lib/libwgpu_native.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>

  <!--
    The from-source WPF fork, as built artifacts (eng/build-sdk.sh). Referenced rather than
    ProjectReference'd because these build through the Arcade SDK, which does not participate in
    the Android build — same arrangement as IosSpike.
  -->
  <ItemGroup>
    <Reference Include="WindowsBase">           <HintPath>$(_Art)/WindowsBase/Release/net10.0/WindowsBase.dll</HintPath></Reference>
    <Reference Include="System.Xaml">           <HintPath>$(_Art)/System.Xaml/Release/net10.0/System.Xaml.dll</HintPath></Reference>
    <Reference Include="PresentationCore">      <HintPath>$(_Art)/PresentationCore/Release/net10.0/PresentationCore.dll</HintPath></Reference>
    <Reference Include="PresentationFramework"> <HintPath>$(_Art)/PresentationFramework/Release/net10.0/PresentationFramework.dll</HintPath></Reference>
    <Reference Include="DirectWriteForwarder">  <HintPath>$(_Art)/DirectWriteForwarderStub/Release/net10.0/DirectWriteForwarder.dll</HintPath></Reference>
    <Reference Include="ReachFramework">        <HintPath>$(_Art)/ReachFramework/Release/net10.0/ReachFramework.dll</HintPath></Reference>
    <Reference Include="PresentationUI">        <HintPath>$(_Art)/PresentationUI/Release/net10.0/PresentationUI.dll</HintPath></Reference>
    <Reference Include="System.Printing">       <HintPath>$(_Art)/System.Printing-ref/Release/net10.0/System.Printing.dll</HintPath></Reference>
    <Reference Include="UIAutomationTypes">     <HintPath>$(_Art)/UIAutomationTypes/Release/net10.0/UIAutomationTypes.dll</HintPath></Reference>
    <Reference Include="UIAutomationProvider">  <HintPath>$(_Art)/UIAutomationProvider/Release/net10.0/UIAutomationProvider.dll</HintPath></Reference>
    <Reference Include="PresentationFramework.Aero2"><HintPath>$(_Art)/PresentationFramework.Aero2/Release/net10.0/PresentationFramework.Aero2.dll</HintPath></Reference>
  </ItemGroup>

  <!-- Assemblies the WPF closure names but no Android path reaches. They still have to RESOLVE for
       the build to complete, exactly as on iOS. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageReference Include="System.IO.Packaging" Version="10.0.10" />
    <!-- The REAL assembly, not the WindowsDesktop reference: mono-aot-cross reads signatures out of
         it while compiling PresentationCore, and a reference assembly answers with the wrong
         identity. Without it the AOT compiler does not fail cleanly, it SEGFAULTS (exit 139) part
         way through PresentationCore, which is why this closure has to match the gallery's rather
         than merely be "enough to compile". See WpfStageAotResolvableRefs below. -->
    <PackageReference Include="System.Formats.Nrbf" Version="10.0.10" />
    <PackageReference Include="System.Windows.Extensions" Version="10.0.10" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.10" />
    <PackageReference Include="System.Security.Permissions" Version="10.0.10" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

  <!--
    Accessibility and System.Windows.Primitives come from the FORK's own build; only
    System.Private.Windows.Core is still a WindowsDesktop reference assembly here, and it is bundled
    purely so the AOT compiler can resolve everything WindowsBase names - nothing loads it.
  -->
  <PropertyGroup>
    <_WinDesktopRef>$(NuGetPackageRoot)microsoft.windowsdesktop.app.ref/10.0.10/ref/net10.0</_WinDesktopRef>
  </PropertyGroup>
  <ItemGroup>
    <!-- Windows-only assemblies WindowsBase/PresentationCore reference from code paths Android never
         executes (SplashScreen's WndProc, UnsafeNativeMethods.ObjectFromLresult). The REFERENCE
         assemblies are enough: the runtime never loads them. -->
    <Reference Include="Accessibility">              <HintPath>$(_Art)/Accessibility/Release/net10.0/Accessibility.dll</HintPath></Reference>
    <Reference Include="System.Windows.Primitives">  <HintPath>$(_Art)/System.Windows.Primitives/Release/net10.0/System.Windows.Primitives.dll</HintPath></Reference>
    <Reference Include="System.Private.Windows.Core"><HintPath>$(_WinDesktopRef)/System.Private.Windows.Core.dll</HintPath></Reference>
    <Reference Include="PresentationFramework.Fluent"><HintPath>$(_Art)/PresentationFramework.Fluent/Release/net10.0/PresentationFramework.Fluent.dll</HintPath></Reference>
    <Reference Include="Microsoft.Win32.SystemEvents"><HintPath>$(_Art)/Microsoft.Win32.SystemEvents/Release/net10.0/Microsoft.Win32.SystemEvents.dll</HintPath></Reference>
    <Reference Include="Microsoft.Win32.Registry">    <HintPath>$(_Art)/Microsoft.Win32.Registry/Release/net10.0/Microsoft.Win32.Registry.dll</HintPath></Reference>
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.10" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" ExcludeAssets="all" />
  </ItemGroup>

  <!--
    Keep the Windows-only shim assemblies out of AOT.

    The authoritative copy of this is WpfWebGpuExcludeWindowsShimsFromAot in the packaged SDK
    (sdk/WpfWebGpu.Sdk/Sdk/Sdk.targets), and WpfGalleryAndroid.csproj carries the same repeat for the
    same reason: this project references the fork by PATH rather than through that SDK, so it has to
    do the work itself.

    mono-aot-cross has to RESOLVE every reference in an assembly it compiles, and this closure is
    full of edges that only exist on Windows: PresentationUI names System.Windows.Forms,
    System.Private.Windows.Core names System.Formats.Nrbf, and so on. Those reference assemblies are
    here to satisfy the compiler, not to run, so AOT fails on them ("Could not load file or assembly
    ... System.Windows.Forms") and takes the whole build with it. Nothing on an Android code path
    reaches any of them.

    Excluding an assembly from AOT is not excluding it from the app: it ships as IL and Mono runs it
    under the JIT if anything ever does call into it.
  -->
  <Target Name="WpfExcludeWindowsShimsFromAot" AfterTargets="_AndroidAotInputs">
    <ItemGroup>
      <_AndroidAotInputs Remove="@(_AndroidAotInputs)"
                         Condition="'%(Filename)' == 'PresentationUI'
                                 Or '%(Filename)' == 'ReachFramework'
                                 Or '%(Filename)' == 'System.Printing'
                                 Or '%(Filename)' == 'System.Windows.Primitives'
                                 Or '%(Filename)' == 'System.Private.Windows.Core'
                                 Or '%(Filename)' == 'System.Formats.Nrbf'
                                 Or '%(Filename)' == 'Accessibility'
                                 Or '%(Filename)' == 'UIAutomationTypes'
                                 Or '%(Filename)' == 'UIAutomationProvider'
                                 Or '%(Filename)' == 'System.Drawing.Common'" />
    </ItemGroup>
  </Target>

  <!--
    Put System.Formats.Nrbf where mono-aot-cross can find it. PresentationCore's DataObject
    serialisation path names the type, so AOT has to resolve the assembly to read a signature while
    compiling PresentationCore even though nothing on Android calls it. mono-aot-cross has no
    search-path option and resolves beside the assembly it is compiling, so the reference assembly is
    staged into linked/ for it to find. See the same target in WpfGalleryAndroid.csproj.
  -->
  <Target Name="WpfStageAotResolvableRefs" BeforeTargets="_AndroidAotCompilation">
    <ItemGroup>
      <_WpfAotResolvable Include="@(RuntimeCopyLocalItems)" Condition="'%(Filename)' == 'System.Formats.Nrbf'" />
    </ItemGroup>
    <Copy SourceFiles="@(_WpfAotResolvable)" DestinationFolder="$(IntermediateOutputPath)linked"
          SkipUnchangedFiles="true" Condition="'@(_WpfAotResolvable)' != '' And Exists('$(IntermediateOutputPath)linked')" />
  </Target>

</Project>
