<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <WgpuRid Condition="'$(WgpuRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</WgpuRid>
    <WgpuNativeDir>$(MSBuildThisFileDirectory)..\..\native\$(WgpuRid)\lib\</WgpuNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WgpuInterop.csproj" />
    <!-- Reuse the SurfaceDemo's Win32 window helper. -->
    <Compile Include="..\WgpuInterop.SurfaceDemo\Win32Window.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(WgpuNativeDir)wgpu_native.dll"   Condition="Exists('$(WgpuNativeDir)wgpu_native.dll')"   CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(WgpuNativeDir)libwgpu_native.so" Condition="Exists('$(WgpuNativeDir)libwgpu_native.so')" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(WgpuNativeDir)libwgpu_native.dylib" Condition="Exists('$(WgpuNativeDir)libwgpu_native.dylib')" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>
