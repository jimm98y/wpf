<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Browser/WebAssembly flavor of Microsoft.Wpf.Interop.WebGpu: same sources
         and assembly identity as ../WgpuInterop.csproj, but the wgpu-native
         DllImport entry points (Wgpu.Native.cs + Wgpu.Lifecycle.cs) are replaced
         by JS-interop implementations over the browser's own WebGPU
         (Wgpu.Browser.cs / wgpu-interop.js). Plain net10.0: [JSImport] compiles
         everywhere and only executes on the browser runtime. -->
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AssemblyName>Microsoft.Wpf.Interop.WebGpu</AssemblyName>
    <RootNamespace>Microsoft.Wpf.Interop.WebGpu</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <DefineConstants>$(DefineConstants);WGPU_BROWSER</DefineConstants>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\**\*.cs"
             Exclude="..\Wgpu.Native.cs;..\Wgpu.Lifecycle.cs;..\tests\**;..\native\**;..\bin\**;..\obj\**;..\Browser\bin\**;..\Browser\obj\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WGSL the renderer loads through ShaderSource.ReadRaw, embedded under the SAME manifest
         names as ../WgpuInterop.csproj produces (RootNamespace + Composition.Shaders.<file>). Without
         these the browser build compiles and boots, then throws "Missing embedded WGSL resource" on
         the first geometry fill and the canvas stays black. LogicalName is explicit because the
         sources are linked in from outside this project directory. -->
    <EmbeddedResource Include="..\Composition\Shaders\*.wgsl">
      <LogicalName>Microsoft.Wpf.Interop.WebGpu.Composition.Shaders.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the JS half next to the assembly so app heads can copy it to wwwroot. -->
    <None Include="wgpu-interop.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
