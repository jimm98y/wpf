<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <!-- Browser/WebAssembly head for the WinForms-on-WebGPU port: the SAME managed Mono
       System.Windows.Forms + XplatUIWebGpu driver + vendored System.Drawing that the mac
       host runs, but presented to a <canvas> WebGPU surface via the BROWSER flavor of the
       WebGPU interop (JS interop over navigator.gpu). DOM events feed the driver's input.
       Assembly name is "WinFormsHost" so it inherits WgpuInterop's InternalsVisibleTo. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WinFormsHost</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>WasmBoot</StartupObject>
    <!-- The host reflects the driver's internal methods (GetPaintVersion / GetPresentWindows / inject*),
         which the publish trimmer would otherwise strip (they have no static callers). No AOT yet, so
         nothing requires trimming; disable it wholesale. -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Repo root props turn style analyzers into build errors; this head compiles as-is. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <!-- Shared present path + host interface reused from the desktop host (platform-neutral). -->
  <ItemGroup>
    <Compile Include="..\host\WgpuPresenter.cs" Link="WgpuPresenter.cs" />
    <Compile Include="..\host\IWinFormsHost.cs" Link="IWinFormsHost.cs" />
  </ItemGroup>

  <!-- The managed WinForms stack (built by the desktop projects; platform-neutral IL) plus the
       BROWSER flavor of the WebGPU interop (same AssemblyName, resolves the C-ABI to navigator.gpu). -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms"><HintPath>..\bin\Release\net10.0\System.Windows.Forms.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Mono.System.Drawing"><HintPath>..\sysdrawing\bin\Release\net10.0\Mono.System.Drawing.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Accessibility"><HintPath>..\lib\Accessibility.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Wpf.Interop.WebGpu"><HintPath>..\..\WgpuInterop\Browser\bin\Release\net10.0\Microsoft.Wpf.Interop.WebGpu.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>

  <!-- Strip the framework System.Drawing.* (dragged in transitively) so our vendored
       Mono.System.Drawing is the sole System.Drawing.* provider (avoids CS0433). -->
  <Target Name="StripFrameworkDrawing" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)"
                     Condition="'%(FileName)' == 'System.Drawing' or '%(FileName)' == 'System.Drawing.Common' or '%(FileName)' == 'System.Drawing.Primitives'" />
    </ItemGroup>
  </Target>

  <!-- Keep the served JS interop modules in sync with their sources. Must run before
       static-web-asset discovery or the integrity hashes go stale. -->
  <Target Name="CopyInteropJs" BeforeTargets="PrepareForBuild;ResolveProjectStaticWebAssets">
    <Copy SourceFiles="..\..\WgpuInterop\Browser\wgpu-interop.js" DestinationFolder="wwwroot" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

</Project>
