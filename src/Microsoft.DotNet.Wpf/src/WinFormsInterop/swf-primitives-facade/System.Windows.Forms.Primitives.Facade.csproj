<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The System.Windows.Forms.Primitives assembly IDENTITY.

    .NET split a handful of WinForms' public types (Message, Padding, HighDpiMode, ScreenOrientation,
    the live-region automation types...) out into System.Windows.Forms.Primitives, so a library
    compiled against .NET names them there: Control.WndProc(ref [System.Windows.Forms.Primitives]Message)
    is what every control that overrides WndProc was built against. They are all System.Windows.Forms
    types here, as in Mono and .NET Framework; this carries the identity and forwards each of them.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Windows.Forms.Primitives</AssemblyName>
    <RootNamespace>System.Windows.Forms</RootNamespace>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>99.0.0.0</FileVersion>
    <Version>10.0.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS1591</NoWarn>
    <!-- The ECMA key, like .NET's own (token b77a5c561934e089); PublicSign, as for System.Windows.Forms. -->
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)../../../../../eng/snk/ECMA.snk</AssemblyOriginatorKeyFile>
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Forwards.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../System.Windows.Forms.WebGpu.csproj" Aliases="swf" />
  </ItemGroup>

</Project>
