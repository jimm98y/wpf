<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds Mono's managed System.Windows.Forms (fully-managed control painting) on net10 with our
    cross-platform XplatUIWebGpu driver (gen/), so legacy WinForms apps run on the WebGPU stack.
    The Mono S.W.F source is VENDORED under swf/ (self-contained — no external mono checkout). The
    native platform drivers (X11/Carbon), Mono WebBrowser, and NUnit tests were pruned when
    vendoring; our edits vs upstream Mono are recorded in mono-patches/mono-swf.patch. See README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Windows.Forms</AssemblyName>
    <RootNamespace>System.Windows.Forms</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The vendored swf/resources/*.resx now live inside the project dir; stop the SDK from
         auto-including them (Resources.targets includes them explicitly with the right LogicalName). -->
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <DefineConstants>MONO;SECURITY_DEP;NET_4_5</DefineConstants>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0672;CS1591;CS0809;CS0114;CS0108;CS0114;CS0169;CS0649;CS0067;CS0642;CS0219;CS0162;CS0164;CS0628;CS0659;CS0660;CS0661</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>false</SignAssembly>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunAnalyzers>false</RunAnalyzers>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <!-- Vendored Mono managed WinForms sources (swf/). The native X11/Carbon drivers, Mono
         WebBrowser, and test files were removed during vendoring, so no Compile Remove is needed.
         XplatUIWin32.cs is KEPT (compile-only): cross-platform files call its static P/Invoke
         helpers; the DllImports never run (XplatUI selects our WebGPU driver). -->
    <Compile Include="swf/System.Windows.Forms/**/*.cs" />
    <Compile Include="swf/System.Windows.Forms.Design/**/*.cs" />
    <Compile Include="swf/System.Windows.Forms.Layout/**/*.cs" />
    <Compile Include="swf/System.Windows.Forms.VisualStyles/**/*.cs" />
    <Compile Include="swf/System.Windows.Forms.PropertyGridInternal/**/*.cs" />
    <Compile Include="swf/System.Windows.Forms.Internal/**/*.cs" />
    <Compile Include="swf/System.Windows.Forms.RTF/**/*.cs" />
    <Compile Include="swf/System.Windows.Forms.Theming/**/*.cs" />
    <Compile Include="swf/System.Windows.Forms.WebBrowserDialogs/**/*.cs" />
    <Compile Include="swf/Assembly/**/*.cs" />

    <!-- Two Mono commons that lived outside the S.W.F tree (vendored into swf/common/), plus our
         generated driver/consts + shims. -->
    <Compile Include="swf/common/MonoTODOAttribute.cs" />
    <Compile Include="swf/common/MonoToolsLocator.cs" />
    <Compile Include="gen/Consts.cs" />
    <Compile Include="gen/XplatUIWebGpu.cs" />
    <Compile Include="gen/XplatUIWebGpu.Core.cs" />
    <Compile Include="shims/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- UITypeEditor is provided by our shim (shims/DrawingDesignShim.cs). Accessibility
         (IAccessible et al.) is VENDORED under lib/ (a metadata-only interop assembly; it also
         satisfies the interface types at runtime off-Windows) so the repo stays fully portable. -->
    <Reference Include="Accessibility">
      <HintPath>lib/Accessibility.dll</HintPath>
    </Reference>
    <!-- Our own vendored Mono System.Drawing (the GPU-raster backend target), replacing the
         System.Drawing.Common 6.0.0 NuGet package. -->
    <ProjectReference Include="sysdrawing/System.Drawing.WebGpu.csproj" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
    <PackageReference Include="System.CodeDom" Version="10.0.0" />
    <PackageReference Include="System.Security.Permissions" Version="10.0.0" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
  </ItemGroup>

  <!-- System.Security.Permissions transitively drags in System.Drawing.Common + System.Drawing.
       Primitives, which duplicate every type our own System.Drawing provides (Color/Rectangle/
       Graphics/…) → CS0433. Strip those two resolved references so our System.Drawing is the sole
       provider of the System.Drawing.* types. -->
  <Target Name="StripFrameworkDrawing" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)"
                     Condition="'%(FileName)' == 'System.Drawing' or '%(FileName)' == 'System.Drawing.Common' or '%(FileName)' == 'System.Drawing.Primitives'" />
    </ItemGroup>
  </Target>

  <Import Project="gen/Resources.targets" />
</Project>
