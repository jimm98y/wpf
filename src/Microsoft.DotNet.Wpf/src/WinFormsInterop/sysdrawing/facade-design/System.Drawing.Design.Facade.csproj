<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The System.Drawing.Design assembly IDENTITY.

    The same job the sibling System.Drawing facade does, for the assembly .NET Core-era code names
    when it points at a UITypeEditor: "System.Drawing.Design, Version=4.0.0.0, Culture=neutral,
    PublicKeyToken=b03f5f7f11d50a3a". Nothing in the shared framework this app targets answers to
    that name, so without this it simply fails to load and the attribute naming it is ignored.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Drawing.Design</AssemblyName>
    <RootNamespace>System.Drawing.Design</RootNamespace>
    <!-- The Framework identity callers ask for. -->
    <AssemblyVersion>4.0.0.0</AssemblyVersion>
    <FileVersion>99.0.0.0</FileVersion>
    <Version>4.0.0.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS1591</NoWarn>

    <!--
      PublicSign, not real signing: MSFT.snk is a public-key blob with no private half, so the
      signature it writes is not valid and .NET does not check it. What matters is the resulting
      identity: the public key token callers named. The same pattern System.Design and
      System.Windows.Forms already use here.
    -->
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)../../../../../../eng/snk/MSFT.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="Forwards.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Through an alias: the framework's own System.Drawing.Primitives and
         System.ComponentModel.TypeConverter declare Point, Size, Rectangle and the converters too,
         so the names are ambiguous without one. The alias says which assembly each forward means. -->
    <ProjectReference Include="../System.Drawing.WebGpu.csproj" Aliases="mono" />
  </ItemGroup>

</Project>
