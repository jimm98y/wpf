<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The System.Drawing.Common assembly IDENTITY, forwarded to Mono.System.Drawing.

    A library built against .NET (Core) names Bitmap, Font, Graphics, Image, Region... as
    [System.Drawing.Common, Version=10.0.0.0, PublicKeyToken=cc7b13ffcd2ddd51]. facade/ does the same
    job for the .NET Framework identity (System.Drawing 4.0.0.0); this is its .NET twin. Without it such
    a reference binds to the real System.Drawing.Common package, whose Graphics this WinForms does not
    draw with (and which throws PlatformNotSupportedException off Windows from its first member), and a
    prebuilt control calling Control.set_Font(Font) fails with MissingMethodException.

    Forwards every public type of System.Drawing.Common 10 that Mono.System.Drawing implements; the
    System.Drawing.Primitives types that package itself forwards go to the framework, as there.
    Not implemented by Mono.System.Drawing, so not forwarded (a reference to one fails to load):
    CachedBitmap, Imaging.Effects.*, Interop.LOGFONT, StockIconId, StockIconOptions.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Drawing.Common</AssemblyName>
    <RootNamespace>System.Drawing</RootNamespace>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <!-- Above the System.Drawing.Common package's, so the SDK's conflict resolution keeps this file
         when the package is also in the closure (see facade/AssemblyInfo.cs for the same tie). -->
    <FileVersion>99.0.0.0</FileVersion>
    <Version>10.0.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS1591</NoWarn>
    <!-- PublicSign with the public key of the real package (token cc7b13ffcd2ddd51), the same one the
         SystemEvents shim carries: the identity is what callers bind to; .NET does not verify it. -->
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>drawingcommon.publickey</AssemblyOriginatorKeyFile>
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Forwards.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Through an alias, as in facade/: the framework declares Point, Size, Rectangle too. -->
    <ProjectReference Include="../System.Drawing.WebGpu.csproj" Aliases="mono" />
  </ItemGroup>

  <!-- The System.Drawing.Common package comes in transitively (System.Security.Permissions); its
       types would be ambiguous with the forwards' targets. -->
  <Target Name="StripFrameworkDrawingCommon" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(FileName)' == 'System.Drawing.Common' or '%(FileName)' == 'System.Drawing'" />
    </ItemGroup>
  </Target>

</Project>
