<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds Mono's managed System.Drawing (VENDORED here: mono/ = Mono's own source, corefx/ = the
    mono-corefx files its .sources pulls in, build/ = Mono build commons) on net10. This is the
    System.Drawing WE own: its single P/Invoke seam (mono/System.Drawing/gdipFunctions.cs, ~580
    Gdip* imports → libgdiplus) is what a later step reroutes to the WgpuInterop GPU rasterizer so
    WinForms controls draw through WebGPU. Self-contained (no external mono/corefx checkout).
    Flags mirror Mono's Makefile: /unsafe -d:FEATURE_TYPECONVERTER,SUPPORTS_WINDOWS_COLORS.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- NOT "System.Drawing": that collides with the inbox System.Drawing facade (which forwards to
         System.Drawing.Common), and the SDK's conflict resolution silently prefers the facade over
         our copy. A distinct assembly name makes ours the unambiguous provider of the System.Drawing
         namespace (the namespace is still System.Drawing; only the assembly file name differs). -->
    <AssemblyName>Mono.System.Drawing</AssemblyName>
    <RootNamespace>System.Drawing</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <DefineConstants>MONO;FEATURE_TYPECONVERTER;SUPPORTS_WINDOWS_COLORS;NET_4_5</DefineConstants>
    <NoWarn>$(NoWarn);CS0618;CS0612;CS0672;CS1591;CS0809;CS0114;CS0108;CS0169;CS0649;CS0067;CS0642;CS0219;CS0162;CS0164;CS0628;CS0659;CS0660;CS0661;CS0465;CS0436;CS3021</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>false</SignAssembly>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exactly the files Mono's System.Drawing.dll.sources compiles (copied 1:1). -->
    <Compile Include="mono/**/*.cs" />
    <Compile Include="corefx/**/*.cs" />
    <Compile Include="build/**/*.cs" />
    <Compile Include="GdiPlusResolver.cs" />   <!-- maps "gdiplus" -> libgdiplus at runtime -->
    <Compile Include="backend/**/*.cs" />       <!-- IGpuSceneRecorder seam + WgpuInterop backend -->
  </ItemGroup>
  <ItemGroup>
    <!-- The WgpuInterop GPU rasterizer: the SceneRecorder backend rerouted the Graphics draw verbs
         into its scene graph. Its internals are exposed via InternalsVisibleTo("Mono.System.Drawing"). -->
    <ProjectReference Include="../../WgpuInterop/WgpuInterop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PermissionSet / CodeAccessPermission / IUnrestrictedPermission are type-forwarded here. -->
    <PackageReference Include="System.Security.Permissions" Version="10.0.0" />
  </ItemGroup>

</Project>
