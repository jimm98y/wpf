<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    The WebGPU compositor backend, deployed beside every test assembly.

    DUCE.ManagedComposition uses it whenever it can be loaded (the AppContext switch defaults to on),
    and without it registering a sink there is no compositor: anything that brings a MediaContext up,
    which `new Window()` does, used to fall through to milcore and die with DllNotFoundException for
    wpfgfx_cor3.dll. Referencing it here makes the tests run the same composition path a real app
    runs, rather than a configuration that exists nowhere else.
  -->
  <ItemGroup>
    <ProjectReference Include="$(WpfSourceDir)WgpuInterop\WgpuInterop.csproj" Private="true" />
  </ItemGroup>

  <!--
    There are deliberately no native dependencies here.

    This used to build five C++ projects (D3DCompiler, PresentationNative, VCRuntime, PenImc,
    wpfgfx) and binplace their DLLs beside every test assembly. The port has managed replacements
    for all of them and ships none of them on any platform, so a test that needed one would be
    testing something the product does not do: composition is the managed WebGPU engine, text and
    geometry are managed, media goes through IMediaBackend, and stylus/touch uses WM_POINTER. The
    references also made every test project depend on a C++ toolchain, which is what stopped them
    building for AnyCPU at all.
  -->

  <!--
   Referencing packages that reference the desktop package causes grief with building internally. Currently this
   is only happening with referencing StaFact (for [WpfFact] tests). Remove the reference if it comes in directly
   or transitively.
  -->
  <Target Name="RemoveDesktopFramework" AfterTargets="ProcessFrameworkReferences" BeforeTargets="FixupRuntimeFrameworkVersions">
    <ItemGroup>
      <RuntimeFramework Remove="@(RuntimeFramework)" Condition="'%(RuntimeFramework.Identity)' == 'Microsoft.WindowsDesktop.App'"/>
    </ItemGroup>
  </Target>

  <!-- See RemoveDesktopFramework above -->
  <Target Name="RemoveTransitiveDesktopFramework" AfterTargets="ResolvePackageAssets" BeforeTargets="AddTransitiveFrameworkReferences">
    <ItemGroup>
      <TransitiveFrameworkReference Remove="@(TransitiveFrameworkReference)" Condition="'%(TransitiveFrameworkReference.Identity)' == 'Microsoft.WindowsDesktop.App'"/>
    </ItemGroup>
  </Target>
</Project>
