<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The WPF/WinForms interop seam: what happens where a hosted WinForms control meets WPF.

    Drag and drop is the first thing here because it is the one interaction that has to cross the
    boundary in BOTH directions: a drag entering the host has to reach the hosted control, and a
    drag the hosted control starts has to be handed to WPF, which owns the window. The two stacks
    have separate IDataObject types and separate DragDropEffects enums, so the crossing needs
    adapters, and adapters are exactly the kind of thing that looks obviously right and is not.

    References both fork assemblies by path, as the sibling suites do; skipped entirely when the
    fork has not been built.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseAppHost>true</UseAppHost>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CS8002;CA1416</NoWarn>

    <!--
      Strong-named with the ECMA standard key.

      WindowsBase grants friend access to this assembly (WindowsBase/LibraryAssemblyInfo.cs) so the
      clipboard tests can reach the internal PlatformClipboard seam, and a strong-named assembly only
      accepts strong-named friends: without this the build fails with CS0281, "the public key of the
      output assembly ('') does not match". The Arcade UnitTests projects get this from
      StrongNameKeyId=ECMA, which this project does not inherit because it deliberately sits outside
      Arcade (see the empty Directory.Build.props one level up).

      PublicSign rather than real signing: the key is public, so there is no private half to sign
      with, and public-signing is what produces an assembly carrying the right public key without
      one. The key is vendored at eng/snk so the build does not depend on a NuGet cache path.
    -->
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)../../../../../eng/snk/ECMA.snk</AssemblyOriginatorKeyFile>

    <_Art>$(MSBuildThisFileDirectory)../../../../../artifacts/bin</_Art>
    <!-- The WinForms halves build to their own bin/ rather than into artifacts/bin. -->
    <_Swf>$(MSBuildThisFileDirectory)../../../src/WinFormsInterop/bin/Release/net10.0</_Swf>
    <_ForkBuilt Condition="Exists('$(_Art)/WindowsBase/Release/net10.0/WindowsBase.dll') And Exists('$(_Swf)/System.Windows.Forms.dll')">true</_ForkBuilt>
    <WgpuRid Condition="'$(WgpuRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</WgpuRid>
    <WgpuNativeDir>$(MSBuildThisFileDirectory)../../../src/WgpuInterop/native/$(WgpuRid)/lib/</WgpuNativeDir>
  </PropertyGroup>

  <!-- The engine's native half: a shown form brings its host window and compositor up for real
       (PopupOverHostedContentTests). -->
  <!-- WindowsBase uses System.Private.Windows.Core at run time (its DWM and OS-version helpers; a WPF
       window that resizes at a scale other than 100% reaches it), as the product payload ships it: the
       fork's source build (see sdk/WpfWebGpu.Sdk/Sdk/WindowsCore.targets).
       Copied, not referenced: naming it at compile time would clash with this stack's own types. -->
  <ItemGroup Condition="'$(_ForkBuilt)' == 'true'">
    <None Include="$(WpfWindowsCoreDll)"
          Link="System.Private.Windows.Core.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(_Art)/System.Windows.Primitives/Release/net10.0/System.Windows.Primitives.dll"
          Link="System.Windows.Primitives.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(_ForkBuilt)' == 'true'">
    <None Include="$(WgpuNativeDir)libwgpu_native.so" Condition="Exists('$(WgpuNativeDir)libwgpu_native.so')"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(WgpuNativeDir)libwgpu_native.dylib" Condition="Exists('$(WgpuNativeDir)libwgpu_native.dylib')"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(WgpuNativeDir)wgpu_native.dll" Condition="Exists('$(WgpuNativeDir)wgpu_native.dll')"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.0.0" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="1.7.3" />
    <!-- Named by the PresentationFramework closure a real Window loads (as in Wpf.Window.Tests). -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.10" />
    <PackageReference Include="System.IO.Packaging" Version="10.0.10" />
    <!-- System.Design's CodeDom serializers need it at run time (the designer serialization tests). -->
    <PackageReference Include="System.CodeDom" Version="10.0.0" />
  </ItemGroup>

  <!--
    The Windows half of the control comparison. Built alongside but NOT referenced: it binds the real
    System.Windows.Forms, which declares the same types as the fork's, and referencing it here would
    put both in one compilation. The test starts it as a process and reads the pixels it leaves
    behind. ReferenceOutputAssembly=false is what says "build this, do not link it".

    Windows-only: on any other OS there is no Microsoft.WindowsDesktop.App to build it against, and
    the test that drives it skips itself.
  -->
  <ItemGroup Condition="'$(_ForkBuilt)' == 'true' And $([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="ControlParity/StockRenderer/StockRenderer.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SetTargetFramework="TargetFramework=net10.0-windows" />
  </ItemGroup>

  <!-- The runtime detours wpfrun installs in every app on macOS (WpfWebGpu.Detours: STA threads, the
       system colours asked of the stack's user32 rather than .NET's compiled-in Windows XP palette,
       machine-wide folders, ...), from wpfrun's payload when it has been built: the tests then run in
       the process an app gets (PlatformDetours.cs). -->
  <PropertyGroup>
    <_WpfrunPayload>$(MSBuildThisFileDirectory)../../../../../artifacts/wpfrun/$(NETCoreSdkRuntimeIdentifier)/overlay/wpfrun.payload/</_WpfrunPayload>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('$(_WpfrunPayload)WpfWebGpu.Detours.dll')">$(DefineConstants);WPFRUN_DETOURS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('$(_WpfrunPayload)WpfWebGpu.Detours.dll')">
    <Reference Include="WpfWebGpu.Detours"><HintPath>$(_WpfrunPayload)WpfWebGpu.Detours.dll</HintPath><Private>true</Private></Reference>
    <!-- the stack's user32, which the system colours are asked of (loaded by name, so in the deps) -->
    <Reference Include="WpfWebGpu.Win32"><HintPath>$(_WpfrunPayload)WpfWebGpu.Win32.dll</HintPath><Private>true</Private></Reference>
    <None Include="$(_WpfrunPayload)MonoMod.*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- The PDF reader the printing tests next door read WPF's PDFs back with; WinForms' printed
       PDFs are written by the same writer and read back the same way (PrintingTests). -->
  <ItemGroup>
    <Compile Include="../Wpf.Printing.Tests/PdfReader.cs" Link="PdfReader.cs" />
  </ItemGroup>

  <!-- Image samples written by real GDI+ (and by hand for what GDI+ never writes), with what GDI+
       reads back from each: the oracle the managed Image layer is held to (ManagedImageTests).
       Fixtures/Images/oracle/gen.ps1 regenerates them under Windows PowerShell 5.1. -->
  <ItemGroup>
    <None Include="Fixtures/Images/*" CopyToOutputDirectory="PreserveNewest" LinkBase="Fixtures/Images" />
    <!-- Metafiles recorded and read by real GDI+ (Fixtures/Metafiles/oracle): what the managed
         Metafile is held to (MetafileTests). -->
    <Compile Remove="Fixtures/Metafiles/oracle/**" />
    <None Include="Fixtures/Metafiles/**/*.emf;Fixtures/Metafiles/**/*.wmf;Fixtures/Metafiles/**/*.txt;Fixtures/Metafiles/**/*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- What native GDI+ hands DrawPlacedGlyphs / DrawLines, measures and adds to a path for a
         battery of strings and formats (FullTextImagerTests). -->
    <None Include="Fixtures/Text/*.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Output profiles crafted for icm32's other output paths (XYZ PCS, v4 lut16 / lutBtoA /
         lutAtoB, refused ones); GpIcmTests holds GpIcm to mscms' KYMC for them. -->
    <None Include="Fixtures/Icm/*.icm" CopyToOutputDirectory="PreserveNewest" />
    <!-- What .NET 10's System.Drawing.Common on native GDI+ throws for every DrawingExceptionCases case
         (DrawingExceptionParityTests, which says how to regenerate it). -->
    <None Include="Fixtures/Drawing/*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/Dpi/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The comparison needs a Windows to compare against; elsewhere it is not built at all. -->
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="ControlParity/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="ControlParity/StockRenderer/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(_ForkBuilt)' == 'true'">
    <Reference Include="WindowsBase"><HintPath>$(_Art)/WindowsBase/Release/net10.0/WindowsBase.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="PresentationCore"><HintPath>$(_Art)/PresentationCore/Release/net10.0/PresentationCore.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="PresentationFramework"><HintPath>$(_Art)/PresentationFramework/Release/net10.0/PresentationFramework.dll</HintPath><Private>true</Private></Reference>
    <!-- What a real WPF Window needs at run time (WindowsFormsHostOnTwoUiThreadsTests shows two). -->
    <Reference Include="System.Xaml"><HintPath>$(_Art)/System.Xaml/Release/net10.0/System.Xaml.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="DirectWriteForwarder"><HintPath>$(_Art)/DirectWriteForwarderStub/Release/net10.0/DirectWriteForwarder.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UIAutomationTypes"><HintPath>$(_Art)/UIAutomationTypes/Release/net10.0/UIAutomationTypes.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UIAutomationProvider"><HintPath>$(_Art)/UIAutomationProvider/Release/net10.0/UIAutomationProvider.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="PresentationFramework.Aero2"><HintPath>$(_Art)/PresentationFramework.Aero2/Release/net10.0/PresentationFramework.Aero2.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="PresentationFramework.Fluent"><HintPath>$(_Art)/PresentationFramework.Fluent/Release/net10.0/PresentationFramework.Fluent.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Windows.Forms"><HintPath>$(_Swf)/System.Windows.Forms.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms"><HintPath>$(_Art)/Microsoft.Web.WebView2.WinForms/Release/net10.0/Microsoft.Web.WebView2.WinForms.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Web.WebView2.Core"><HintPath>$(_Art)/Microsoft.Web.WebView2.Core/Release/net10.0/Microsoft.Web.WebView2.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="WindowsFormsIntegration"><HintPath>$(_Swf)/../../../integration/bin/Release/net10.0/WindowsFormsIntegration.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Mono.System.Drawing"><HintPath>$(_Swf)/Mono.System.Drawing.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Design"><HintPath>$(_Swf)/System.Design.dll</HintPath><Private>true</Private></Reference>
    <!-- The System.Drawing.Design identity an app gets from the SDK: it forwards the file editors to
         WinForms, which is what Image's and Icon's [Editor] attributes resolve through. -->
    <Reference Include="System.Drawing.Design"><HintPath>$(_Swf)/../../../sysdrawing/facade-design/bin/Release/net10.0/System.Drawing.Design.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>

  <!--
    Without the fork there is nothing these can bind against, so compile an explanatory stub instead
    of the tests. A build error here would block anyone working only on the renderer.
  -->
  <ItemGroup Condition="'$(_ForkBuilt)' != 'true'">
    <Compile Remove="**/*.cs" />
    <Compile Include="NotBuilt.cs" />
  </ItemGroup>

  <Target Name="WarnIfForkNotBuilt" BeforeTargets="Build" Condition="'$(_ForkBuilt)' != 'true'">
    <Warning Text="The WPF fork is not built, so the WinForms interop tests are excluded. Run eng/build-sdk.sh to enable them." />
  </Target>

  <!-- Our vendored System.Drawing declares Point, Size, Rectangle, Color and SystemColors, and so
       does the framework's System.Drawing.Primitives, which arrives transitively. With both in scope
       every one of those names is ambiguous (CS0433). The fork's is the one the controls are built
       against, so the framework's goes. The samples that reference the fork do the same. -->
  <Target Name="StripFrameworkDrawing" AfterTargets="ResolveAssemblyReferences"
          Condition="'$(_ForkBuilt)' == 'true'">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)"
                     Condition="'%(FileName)' == 'System.Drawing' or '%(FileName)' == 'System.Drawing.Common'" />
    </ItemGroup>
  </Target>

  <!-- Copy the fork's assemblies next to the test binary; conflict resolution drops framework-named
       ones from the copy set otherwise, and they are then missing at run time. -->
  <Target Name="CopyForkAssemblies" AfterTargets="Build" Condition="'$(_ForkBuilt)' == 'true'">
    <ItemGroup>
      <_ForkAssembly Include="@(Reference->'%(HintPath)')" Condition="'%(Reference.HintPath)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_ForkAssembly)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('%(_ForkAssembly.Identity)')" />
  </Target>

</Project>
