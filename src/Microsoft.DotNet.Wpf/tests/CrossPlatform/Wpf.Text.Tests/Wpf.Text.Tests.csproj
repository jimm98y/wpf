<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The text stack as WPF sees it: font fallback across scripts, and line breaking.

    A layer above Wpf.Platform.Tests, which deliberately references WindowsBase alone. These need
    PresentationCore, because what is under test is what WPF itself resolves and measures: which
    font a run of Japanese ends up in, and where a paragraph of it may be cut. Everything here runs
    through the PUBLIC APIs (Typeface, TextFormatter, GlyphRun), so the tests describe behaviour
    rather than the internals that currently produce it.

    Referenced by path rather than ProjectReference'd, exactly as the sample heads and the platform
    tests are: those projects build through the Arcade SDK, which a plain `dotnet test` does not
    participate in. Run eng/build-sdk.sh first; without the fork the tests are excluded rather than
    failing the build.

    Plain net10.0, NOT net10.0-windows: the whole point is that this text stack has no Windows in it.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseAppHost>true</UseAppHost>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CS8002;CA1416</NoWarn>

    <_Art>$(MSBuildThisFileDirectory)../../../../../artifacts/bin</_Art>
    <_Wgpu>$(MSBuildThisFileDirectory)../../../src/WgpuInterop/bin/Release/net10.0</_Wgpu>
    <WgpuRid Condition="'$(WgpuRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</WgpuRid>
    <WgpuNativeDir>$(MSBuildThisFileDirectory)../../../src/WgpuInterop/native/$(WgpuRid)/lib/</WgpuNativeDir>
    <_ForkBuilt Condition="Exists('$(_Art)/PresentationCore/Release/net10.0/PresentationCore.dll') AND Exists('$(_Wgpu)/Microsoft.Wpf.Interop.WebGpu.dll')">true</_ForkBuilt>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.0.0" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="1.7.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(_ForkBuilt)' == 'true'">
    <Reference Include="WindowsBase"><HintPath>$(_Art)/WindowsBase/Release/net10.0/WindowsBase.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Xaml"><HintPath>$(_Art)/System.Xaml/Release/net10.0/System.Xaml.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="PresentationCore"><HintPath>$(_Art)/PresentationCore/Release/net10.0/PresentationCore.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="DirectWriteForwarder"><HintPath>$(_Art)/DirectWriteForwarderStub/Release/net10.0/DirectWriteForwarder.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Win32.SystemEvents"><HintPath>$(_Art)/Microsoft.Win32.SystemEvents/Release/net10.0/Microsoft.Win32.SystemEvents.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Win32.Registry"><HintPath>$(_Art)/Microsoft.Win32.Registry/Release/net10.0/Microsoft.Win32.Registry.dll</HintPath><Private>true</Private></Reference>
    <!-- The rendering engine. Formatting alone would not need it, but reading the glyph runs back
         means opening a DrawingContext, and that brings up the MediaContext, which resolves its
         engine through this assembly's module initializer. WgpuInterop deliberately builds outside
         Arcade, so its output sits next to the project rather than in artifacts/bin. -->
    <Reference Include="Microsoft.Wpf.Interop.WebGpu"><HintPath>$(_Wgpu)/Microsoft.Wpf.Interop.WebGpu.dll</HintPath><Private>true</Private></Reference>
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.10" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" ExcludeAssets="all" />
  </ItemGroup>

  <!-- Named by the PresentationCore closure; resolved even though these tests never reach them. -->
  <ItemGroup Condition="'$(_ForkBuilt)' == 'true'">
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="System.IO.Packaging" Version="10.0.10" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.10" />
  </ItemGroup>

  <!-- The engine's native half. Nothing here renders, but bringing the MediaContext up loads it. -->
  <ItemGroup Condition="'$(_ForkBuilt)' == 'true'">
    <None Include="$(WgpuNativeDir)libwgpu_native.so" Condition="Exists('$(WgpuNativeDir)libwgpu_native.so')"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(WgpuNativeDir)libwgpu_native.dylib" Condition="Exists('$(WgpuNativeDir)libwgpu_native.dylib')"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(WgpuNativeDir)wgpu_native.dll" Condition="Exists('$(WgpuNativeDir)wgpu_native.dll')"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    Without the fork there is nothing to bind against, so compile an explanatory stub instead of the
    tests rather than breaking the build for someone who only touched the renderer.
  -->
  <ItemGroup Condition="'$(_ForkBuilt)' != 'true'">
    <Compile Remove="**/*.cs" />
    <Compile Include="NotBuilt.cs" />
  </ItemGroup>

  <Target Name="WarnIfForkNotBuilt" BeforeTargets="Build" Condition="'$(_ForkBuilt)' != 'true'">
    <Warning Text="The WPF fork is not built, so the text-stack tests are excluded. Run eng/build-sdk.sh to enable them." />
  </Target>

  <!--
    Existing is not the same as current. These tests bind to artifacts/bin by path, so a checkout
    that moved on since the last eng/build-sdk.sh runs the OLD text stack against the NEW tests, and
    every assertion the newer code was written to satisfy fails. That reads exactly like a product
    regression - it cost a full investigation once - so stop instead, and say which side is stale.

    The comparison is against HEAD's commit date rather than the source files: globbing thousands of
    .cs files on every build would cost more than the mistake. Uncommitted edits are therefore NOT
    caught, and no check here can substitute for rebuilding after touching the fork. If git is
    unavailable the check quietly passes rather than blocking a build it cannot judge.
  -->
  <Target Name="CheckForkNotStale" BeforeTargets="Build"
          Condition="'$(_ForkBuilt)' == 'true' AND '$(AllowStaleFork)' != 'true'">
    <Exec Command="git log -1 --format=%25ct" WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true" StandardOutputImportance="low"
          ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_HeadCommitUnix" />
      <Output TaskParameter="ExitCode" PropertyName="_GitExitCode" />
    </Exec>

    <!-- MSBuild has no file-time property function, so the timestamp comes off item metadata.
         ModifiedTime is local time, hence ToLocalTime on the commit date rather than UtcNow math. -->
    <ItemGroup Condition="'$(_GitExitCode)' == '0' AND '$(_HeadCommitUnix)' != ''">
      <_ForkDll Include="$(_Art)/PresentationCore/Release/net10.0/PresentationCore.dll" />
    </ItemGroup>

    <PropertyGroup Condition="'$(_GitExitCode)' == '0' AND '$(_HeadCommitUnix)' != ''">
      <_ForkModified>@(_ForkDll->'%(ModifiedTime)')</_ForkModified>
      <_ForkTicks Condition="'$(_ForkModified)' != ''">$([System.DateTime]::Parse('$(_ForkModified)').Ticks)</_ForkTicks>
      <_HeadCommitTicks>$([System.DateTime]::new(1970,1,1).AddSeconds($(_HeadCommitUnix)).ToLocalTime().Ticks)</_HeadCommitTicks>
    </PropertyGroup>

    <Error Condition="'$(_ForkTicks)' != '' AND $(_ForkTicks) &lt; $(_HeadCommitTicks)"
           Text="artifacts/bin is older than the checked-out commit, so these tests would run against a stale text stack and fail for reasons that are not in the source. Run eng/build-sdk.sh, or pass -p:AllowStaleFork=true to test the old binaries deliberately." />
  </Target>

  <!-- Copy the fork's assemblies next to the test binary; conflict resolution recognises names like
       PresentationCore as framework-provided and drops them from the copy set otherwise, and they
       are then missing at run time. -->
  <Target Name="CopyForkAssemblies" AfterTargets="Build" Condition="'$(_ForkBuilt)' == 'true'">
    <ItemGroup>
      <_ForkAssembly Include="@(Reference->'%(HintPath)')" Condition="'%(Reference.HintPath)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_ForkAssembly)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('%(_ForkAssembly.Identity)')" />
  </Target>

</Project>
