<Project>
  <!-- Stops the walk into Arcade, as Directory.Build.props does: nothing of the root's is imported
       except the System.Private.Windows.Core guard below. -->
  <!-- System.Private.Windows.Core is the fork's source build, never a package binary: see the
       comment in the imported file. (Projects built with WpfWebGpu.Sdk import it from the SDK,
       which points it at the SDK's own lib/wpf copy.) -->
  <PropertyGroup Condition="'$(WpfWebGpuSdkRoot)' == ''">
    <_WpfWindowsCoreBin>$(MSBuildThisFileDirectory)../../../../artifacts/bin/System.Private.Windows.Core/</_WpfWindowsCoreBin>
    <WpfWindowsCoreDll Condition="'$(WpfWindowsCoreDll)' == '' And '$(Platform)' != '' And '$(Platform)' != 'AnyCPU' And Exists('$(_WpfWindowsCoreBin)$(Platform)/$(Configuration)/net10.0/System.Private.Windows.Core.dll')">$(_WpfWindowsCoreBin)$(Platform)/$(Configuration)/net10.0/System.Private.Windows.Core.dll</WpfWindowsCoreDll>
    <WpfWindowsCoreDll Condition="'$(WpfWindowsCoreDll)' == '' And Exists('$(_WpfWindowsCoreBin)$(Configuration)/net10.0/System.Private.Windows.Core.dll')">$(_WpfWindowsCoreBin)$(Configuration)/net10.0/System.Private.Windows.Core.dll</WpfWindowsCoreDll>
    <WpfWindowsCoreDll Condition="'$(WpfWindowsCoreDll)' == ''">$(_WpfWindowsCoreBin)Release/net10.0/System.Private.Windows.Core.dll</WpfWindowsCoreDll>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../../../sdk/WpfWebGpu.Sdk/Sdk/WindowsCore.targets" Condition="'$(WpfWebGpuSdkRoot)' == ''" />

  <!-- The fonts an app gets beside it on macOS and Linux (WpfWebGpu.Sdk's _WpfWebGpuAppFont, Sdk.targets),
       in fonts/ beside the tests, where SystemFontCatalog's app-local probe finds them: Selawik for
       Segoe UI, Symbols for the icon fonts, Cascadia Code, Noto Sans CJK and the emoji face. Without them
       the tests ran on whatever the machine has (Segoe UI became Helvetica Neue on a Mac, and every
       height measured from the default font was another font's), not on what an app runs on. -->
  <PropertyGroup>
    <_TestFontsRoot>$(MSBuildThisFileDirectory)../../../../sdk/WpfWebGpu.Fonts/fonts/</_TestFontsRoot>
  </PropertyGroup>
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="$(_TestFontsRoot)Symbols.ttf;$(_TestFontsRoot)CascadiaCode-Regular.ttf;$(_TestFontsRoot)Selawik*.ttf;$(_TestFontsRoot)NotoSansCJK-Regular.ttc;$(_TestFontsRoot)TwemojiMozilla.ttf"
          CopyToOutputDirectory="PreserveNewest" Link="fonts/%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>
</Project>
