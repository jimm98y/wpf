<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The CDP inspector's protocol contract, asserted without a browser.

    This is the suite that matters. The DevTools frontend is not a stable API and a Chrome update
    can change what it probes on attach, so "it looked right in the Elements panel yesterday" is
    not a regression test. These drive the endpoint with a ClientWebSocket and assert on the JSON,
    which also demonstrates the second reason the endpoint exists: it is scriptable, so a test or
    a tool can ask a running app what its visual tree is without a debugger attached.

    Same shape as Wpf.DevTools.Tests next door, and for the same reason: a PresentationSource needs
    a real top-level Window, and on macOS AppKit will only build one on the process main thread,
    so Program.cs keeps that thread for the UI and moves the runner beside it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseAppHost>true</UseAppHost>
    <!-- Program.cs replaces the generated entry point; see the reason at the top of that file. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <UseWPF>false</UseWPF>
    <!--
      Strong-named with the ECMA standard key, because WindowsBase grants friend access to this
      assembly (WindowsBase/LibraryAssemblyInfo.cs) and a strong-named assembly only accepts
      strong-named friends. Program.cs needs the internal CocoaWindow.EnsureApplication/PumpEvents to
      claim AppKit's event queue for the main thread before the runner starts. PublicSign rather than
      real signing: the key is public, so there is no private half to sign with.
    -->
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)../../../../../eng/snk/ECMA.snk</AssemblyOriginatorKeyFile>

    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CS8002;CA1416;NU1510</NoWarn>

    <!--
      A real on-screen window needs a display, so on a machine without one EVERY test here skips.
      The test platform counts a run in which nothing executed as FAILED, because its
      minimum-expected-tests option defaults to one, so a correctly and deliberately skipped suite
      came out as "Failed!" and took the exit code of eng/run-tests.sh with it.

      Exit code 8 is that policy and nothing else, so ignoring 8 says exactly "an empty run is an
      acceptable outcome for this suite" and no more. A test that skips still reports as skipped,
      and a FAILING test exits 2, which is untouched. (Setting minimum-expected-tests to zero is the
      obvious alternative and does not work; the option rejects zero and the run fails with exit 5.)
    -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>

    <_Art>$(MSBuildThisFileDirectory)../../../../../artifacts/bin</_Art>
    <_Wgpu>$(MSBuildThisFileDirectory)../../../src/WgpuInterop/bin/Release/net10.0</_Wgpu>
    <_DevTools>$(MSBuildThisFileDirectory)../../../src/WpfDevTools/bin/Release/net10.0</_DevTools>
    <WgpuRid Condition="'$(WgpuRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</WgpuRid>
    <WgpuNativeDir>$(MSBuildThisFileDirectory)../../../src/WgpuInterop/native/$(WgpuRid)/lib/</WgpuNativeDir>
    <_ForkBuilt Condition="Exists('$(_Art)/PresentationFramework/Release/net10.0/PresentationFramework.dll') AND Exists('$(_Wgpu)/Microsoft.Wpf.Interop.WebGpu.dll') AND Exists('$(_DevTools)/Microsoft.Wpf.DevTools.dll')">true</_ForkBuilt>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.0.0" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="1.7.3" />
  </ItemGroup>

  <ItemGroup Condition="'$(_ForkBuilt)' == 'true'">
    <Reference Include="WindowsBase">                 <HintPath>$(_Art)/WindowsBase/Release/net10.0/WindowsBase.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Xaml">                 <HintPath>$(_Art)/System.Xaml/Release/net10.0/System.Xaml.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="PresentationCore">            <HintPath>$(_Art)/PresentationCore/Release/net10.0/PresentationCore.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="PresentationFramework">       <HintPath>$(_Art)/PresentationFramework/Release/net10.0/PresentationFramework.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="DirectWriteForwarder">        <HintPath>$(_Art)/DirectWriteForwarderStub/Release/net10.0/DirectWriteForwarder.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="ReachFramework">              <HintPath>$(_Art)/ReachFramework/Release/net10.0/ReachFramework.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="PresentationUI">              <HintPath>$(_Art)/PresentationUI/Release/net10.0/PresentationUI.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="System.Printing">             <HintPath>$(_Art)/System.Printing.Managed/Release/net10.0/System.Printing.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UIAutomationTypes">           <HintPath>$(_Art)/UIAutomationTypes/Release/net10.0/UIAutomationTypes.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="UIAutomationProvider">        <HintPath>$(_Art)/UIAutomationProvider/Release/net10.0/UIAutomationProvider.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="PresentationFramework.Fluent"><HintPath>$(_Art)/PresentationFramework.Fluent/Release/net10.0/PresentationFramework.Fluent.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="PresentationFramework.Aero2"> <HintPath>$(_Art)/PresentationFramework.Aero2/Release/net10.0/PresentationFramework.Aero2.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Win32.SystemEvents"><HintPath>$(_Art)/Microsoft.Win32.SystemEvents/Release/net10.0/Microsoft.Win32.SystemEvents.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Win32.Registry">    <HintPath>$(_Art)/Microsoft.Win32.Registry/Release/net10.0/Microsoft.Win32.Registry.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Wpf.Interop.WebGpu"><HintPath>$(_Wgpu)/Microsoft.Wpf.Interop.WebGpu.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Microsoft.Wpf.DevTools">      <HintPath>$(_DevTools)/Microsoft.Wpf.DevTools.dll</HintPath><Private>true</Private></Reference>
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.10" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" ExcludeAssets="all" />
  </ItemGroup>

  <!-- Named by the PresentationFramework closure; resolved even though these tests never reach them. -->
  <ItemGroup Condition="'$(_ForkBuilt)' == 'true'">
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="System.IO.Packaging" Version="10.0.10" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.10" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageReference Include="System.CodeDom" Version="10.0.10" />
    <PackageReference Include="System.Formats.Nrbf" Version="10.0.10" />
    <PackageReference Include="System.Windows.Extensions" Version="10.0.10" />
    <PackageReference Include="System.Security.Permissions" Version="10.0.10" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.10" />
  </ItemGroup>

  <!-- The engine's native half: a shown window brings the compositor up for real here. -->
  <ItemGroup Condition="'$(_ForkBuilt)' == 'true'">
    <None Include="$(WgpuNativeDir)libwgpu_native.so" Condition="Exists('$(WgpuNativeDir)libwgpu_native.so')"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(WgpuNativeDir)libwgpu_native.dylib" Condition="Exists('$(WgpuNativeDir)libwgpu_native.dylib')"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(WgpuNativeDir)wgpu_native.dll" Condition="Exists('$(WgpuNativeDir)wgpu_native.dll')"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(_ForkBuilt)' != 'true'">
    <Compile Remove="**/*.cs" />
    <Compile Include="NotBuilt.cs" />
  </ItemGroup>

  <Target Name="WarnIfForkNotBuilt" BeforeTargets="Build" Condition="'$(_ForkBuilt)' != 'true'">
    <Warning Text="The WPF fork is not built, so the inspector tests are excluded. Run eng/build-sdk.sh and build src/WpfDevTools to enable them." />
  </Target>

  <Target Name="CopyForkAssemblies" AfterTargets="Build" Condition="'$(_ForkBuilt)' == 'true'">
    <ItemGroup>
      <_ForkAssembly Include="@(Reference->'%(HintPath)')" Condition="'%(Reference.HintPath)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_ForkAssembly)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('%(_ForkAssembly.Identity)')" />
  </Target>

</Project>
