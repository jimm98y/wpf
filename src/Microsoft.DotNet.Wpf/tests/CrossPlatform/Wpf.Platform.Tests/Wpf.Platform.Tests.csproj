<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The per-OS windowing heads: DPI chain, sizing, screen geometry.

    Separate from WgpuInterop.Tests because it tests a different layer: the windowing heads, which
    sit BELOW WPF. It therefore references WindowsBase ALONE - not PresentationCore, not
    PresentationFramework. The heads are public IPlatformWindow implementations with their own
    Create/GetPixelSize/GetBackingScale surface, so they are driven directly; going through a WPF
    Window would test the integration rather than the head, and would need a Dispatcher and an STA
    thread that does not exist off-Windows.

    Referenced by path rather than ProjectReference'd, exactly as the sample heads are: those
    projects build through the Arcade SDK, which a plain `dotnet test` does not participate in. Run
    eng/build-sdk.sh first. If the fork is not built the whole project is skipped rather than failing
    the build, so `dotnet test` over the repo still works for someone who only touched the renderer.

    Plain net10.0, NOT net10.0-windows: the point is that these run on all three operating systems.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- The WlXkb binding takes byte* buffers, so the keyboard-mapping tests need unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseAppHost>true</UseAppHost>
    <!-- Program.cs replaces the generated entry point; see the reason at the top of that file. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <NoWarn>$(NoWarn);CS8002;CA1416</NoWarn>

    <!--
      Strong-named with the ECMA standard key.

      WindowsBase grants friend access to this assembly (WindowsBase/LibraryAssemblyInfo.cs) so the
      clipboard tests can reach the internal PlatformClipboard seam, and a strong-named assembly only
      accepts strong-named friends: without this the build fails with CS0281, "the public key of the
      output assembly ('') does not match". The Arcade UnitTests projects get this from
      StrongNameKeyId=ECMA, which this project does not inherit because it deliberately sits outside
      Arcade (see the empty Directory.Build.props one level up).

      PublicSign rather than real signing: the key is public, so there is no private half to sign
      with, and public-signing is what produces an assembly carrying the right public key without
      one. The key is vendored at eng/snk so the build does not depend on a NuGet cache path.
    -->
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)../../../../../eng/snk/ECMA.snk</AssemblyOriginatorKeyFile>

    <_Art>$(MSBuildThisFileDirectory)../../../../../artifacts/bin</_Art>
    <_ForkBuilt Condition="Exists('$(_Art)/WindowsBase/Release/net10.0/WindowsBase.dll')">true</_ForkBuilt>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.0.0" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="1.7.3" />
  </ItemGroup>

  <!-- WindowsBase only. If this list ever needs PresentationCore, the test has drifted up a layer. -->
  <ItemGroup Condition="'$(_ForkBuilt)' == 'true'">
    <Reference Include="WindowsBase"><HintPath>$(_Art)/WindowsBase/Release/net10.0/WindowsBase.dll</HintPath><Private>true</Private></Reference>
    <!--
      Named by WindowsBase, not by these tests: the host runs a Dispatcher on the main thread (see
      Program.cs), and the first touch of one initialises BaseCompatibilityPreferences, which reads
      the app config. Without this the host dies before the first test with a TypeInitializationException
      naming System.Configuration.ConfigurationManager, which looks like a broken test assembly
      rather than a missing transitive reference.
    -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.10" />
  </ItemGroup>

  <!--
    Without the fork there is nothing these can bind against, so compile an explanatory stub instead
    of the tests. A build error here would block anyone working only on the renderer.
  -->
  <ItemGroup Condition="'$(_ForkBuilt)' != 'true'">
    <Compile Remove="**/*.cs" />
    <Compile Include="NotBuilt.cs" />
  </ItemGroup>

  <Target Name="WarnIfForkNotBuilt" BeforeTargets="Build" Condition="'$(_ForkBuilt)' != 'true'">
    <Warning Text="The WPF fork is not built, so the platform-head tests are excluded. Run eng/build-sdk.sh to enable them." />
  </Target>

  <!-- Copy the fork's assemblies next to the test binary; conflict resolution drops framework-named
       ones from the copy set otherwise, and they are then missing at run time. -->
  <Target Name="CopyForkAssemblies" AfterTargets="Build" Condition="'$(_ForkBuilt)' == 'true'">
    <ItemGroup>
      <_ForkAssembly Include="@(Reference->'%(HintPath)')" Condition="'%(Reference.HintPath)' != ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_ForkAssembly)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('%(_ForkAssembly.Identity)')" />
  </Target>

</Project>
