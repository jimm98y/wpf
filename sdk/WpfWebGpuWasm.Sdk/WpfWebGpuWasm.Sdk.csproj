<!-- Pack-only project for the WpfWebGpuWasm.Sdk wrapper SDK. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>WpfWebGpuWasm.Sdk</PackageId>
    <Version>0.1.1</Version>
    <Authors>wpf-webgpu</Authors>
    <Description>MSBuild SDK: the browser/WebAssembly head of WpfWebGpu.Sdk as a standalone SDK id — a standard WPF application project targets the browser by switching its Sdk attribute.</Description>
    <PackageType>MSBuildSdk</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);NU5100;NU5110;NU5111;NU5128</NoWarn>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Sdk/**" Pack="true" PackagePath="Sdk/" />
  </ItemGroup>

</Project>
