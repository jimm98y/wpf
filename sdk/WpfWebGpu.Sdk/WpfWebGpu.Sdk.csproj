<!-- Pack-only project: builds the WpfWebGpu.Sdk MSBuild-SDK NuGet directly from the
     repo's build outputs (no staging step — works the same on macOS, Linux, Windows):

         dotnet pack sdk/WpfWebGpu.Sdk/WpfWebGpu.Sdk.csproj -c Release -o artifacts/local-feed \
             -p:ImportDirectoryBuildProps=false -p:ImportDirectoryBuildTargets=false -p:ImportDirectoryPackagesProps=false

     (assemble.sh / assemble.cmd are thin wrappers around exactly that.)
     Rerun after rebuilding the fork so the packaged assemblies are current.

     Flavors are packed based on what's available on the build machine:
       - unix/browser payload (lib/wpf, lib/wpf-browser, lib/wpf-winforms, native/osx-arm64)
         comes from the net10.0 cross-platform fork build under artifacts/bin — packed when it
         exists ($(_HasForkNet10)).
       - the windows head payload (lib/wpf-windows, native/win-arm64) comes from a staged
         win-arm64 fork runtime ($(WpfWinRuntimeDir), defaults to the local testhost) plus the
         WebGPU native runtime ($(WgpuWinNativeDir)) — packed when it exists ($(_HasWinRuntime)). -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>WpfWebGpu.Sdk</PackageId>
    <Version>0.1.1</Version>
    <Authors>wpf-webgpu</Authors>
    <Description>MSBuild SDK that builds standard WPF application projects against the from-source WPF-on-WebGPU stack (windows, macOS desktop, and WebAssembly/browser). Every head is self-contained: WPF comes from the packaged fork assemblies, never the stock WindowsDesktop framework.</Description>
    <PackageType>MSBuildSdk</PackageType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);NU5100;NU5110;NU5111;NU5128</NoWarn>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzers>false</RunAnalyzers>

    <WpfRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../..'))</WpfRepoRoot>
    <WpfBin>$(WpfRepoRoot)artifacts/bin/</WpfBin>
    <WgpuInteropDir>$(WpfRepoRoot)src/Microsoft.DotNet.Wpf/src/WgpuInterop/</WgpuInteropDir>
    <WinFormsInteropDir>$(WpfRepoRoot)src/Microsoft.DotNet.Wpf/src/WinFormsInterop/</WinFormsInteropDir>

    <!-- windows head payload sources (overridable). Defaults to the local from-source testhost
         (a staged win-arm64 fork runtime) and the WebGPU native runtime deployed beside the sample. -->
    <WpfWinRuntimeDir Condition="'$(WpfWinRuntimeDir)' == ''">C:/Git/wpf-testhost/shared/Microsoft.WindowsDesktop.App/10.0.9/</WpfWinRuntimeDir>
    <!-- The gallery's TFM moved from net10.0-windows to net10.0, and this pointed at the old output
         directory. Every Include below is Exists-gated, so the package still built - just without a
         WebGPU backend in it, and every app built against it died at startup with
         "DllNotFoundException: wgpu_native". Probe both, and see WpfWebGpuValidateInputs, which now
         refuses to pack a windows head that has no backend rather than shipping that silently. -->
    <WgpuWinNativeDir Condition="'$(WgpuWinNativeDir)' == '' and Exists('$(WpfRepoRoot)samples/wpf-webgpu-gallery/bin/Release/net10.0/wgpu_native.dll')">$(WpfRepoRoot)samples/wpf-webgpu-gallery/bin/Release/net10.0/</WgpuWinNativeDir>
    <WgpuWinNativeDir Condition="'$(WgpuWinNativeDir)' == ''">$(WpfRepoRoot)samples/wpf-webgpu-gallery/bin/Release/net10.0-windows/</WgpuWinNativeDir>

    <!-- Where WebView2Loader.dll is staged for the windows head. It is the one native dependency the
         web view has on Windows (the Edge runtime itself is an OS component, not shipped here).
         Probed first beside the gallery, exactly as wgpu-native is, then in the NuGet cache, so a
         machine that has ever restored the WebView2 package can pack without extra steps. -->
    <WebView2LoaderDir Condition="'$(WebView2LoaderDir)' == '' and Exists('$(WgpuWinNativeDir)WebView2Loader.dll')">$(WgpuWinNativeDir)</WebView2LoaderDir>
    <WebView2LoaderDir Condition="'$(WebView2LoaderDir)' == ''">$(NuGetPackageRoot)microsoft.web.webview2/1.0.4022.49/runtimes/win-arm64/native/</WebView2LoaderDir>

    <!-- Which flavors can be packed from this machine's outputs? -->
    <_HasForkNet10 Condition="Exists('$(WpfBin)PresentationFramework/Release/net10.0/PresentationFramework.dll')">true</_HasForkNet10>
    <_HasWinRuntime Condition="Exists('$(WpfWinRuntimeDir)PresentationFramework.dll')">true</_HasWinRuntime>
  </PropertyGroup>

  <!-- Always present: the SDK itself, host page templates, the fork markup compiler + targets. -->
  <ItemGroup>
    <None Include="Sdk/**" Pack="true" PackagePath="Sdk/" />

    <None Include="web/**" Pack="true" PackagePath="web/" />
    <None Include="$(WgpuInteropDir)Browser/wgpu-interop.js" Pack="true" PackagePath="web/" Condition="Exists('$(WgpuInteropDir)Browser/wgpu-interop.js')" />
    <None Include="$(WpfRepoRoot)src/Microsoft.DotNet.Wpf/src/Shared/MS/Internal/Interop/browser-window.js" Pack="true" PackagePath="web/" Condition="Exists('$(WpfRepoRoot)src/Microsoft.DotNet.Wpf/src/Shared/MS/Internal/Interop/browser-window.js')" />
    <None Include="$(WpfRepoRoot)src/Microsoft.DotNet.Wpf/src/Shared/MS/Internal/Interop/browser-media.js" Pack="true" PackagePath="web/" Condition="Exists('$(WpfRepoRoot)src/Microsoft.DotNet.Wpf/src/Shared/MS/Internal/Interop/browser-media.js')" />

    <!-- XAML markup compiler (fork build) + its targets — required by every head. -->
    <None Include="$(WpfRepoRoot)artifacts/packaging/Release/Microsoft.NET.Sdk.WindowsDesktop/tools/net10.0/PresentationBuildTasks.dll" Pack="true" PackagePath="tools/net10.0/" />
    <None Include="$(WpfRepoRoot)artifacts/packaging/Release/Microsoft.NET.Sdk.WindowsDesktop/targets/Microsoft.WinFX.targets" Pack="true" PackagePath="targets/" />

    <!-- The desktop WebGPU interop (P/Invoke wgpu-native) — used by both the unix and windows
         heads, and always available (built directly under WgpuInterop). -->
    <None Include="$(WgpuInteropDir)bin/Release/net10.0/Microsoft.Wpf.Interop.WebGpu.dll" Pack="true" PackagePath="lib/wpf-desktop/" />
  </ItemGroup>

  <!-- ============================ unix / browser payload ============================ -->
  <ItemGroup Condition="'$(_HasForkNet10)' == 'true'">
    <!-- Shared WPF assemblies (net10.0 cross-platform fork build). -->
    <!-- Every theme, on every head. A theme is resolved by NAME at runtime
         (Assembly.Load of "PresentationFramework.{ThemeName}"), so one that is not in the payload
         is not a theme that falls back gracefully. It is a FileNotFoundException the moment
         anything asks for it, and what asks may be a control's default style rather than the app.
         The assemblies are pure compiled XAML with no platform dependency, so there is nothing
         Windows-only about Aero, AeroLite, Luna or Royale except their names. -->
    <_WpfShared Include="PresentationFramework;PresentationCore;WindowsBase;System.Xaml;ReachFramework;System.Windows.Input.Manipulations;UIAutomationTypes;UIAutomationProvider;System.Windows.Primitives;PresentationFramework.Fluent;PresentationFramework.Aero;PresentationFramework.Aero2;PresentationFramework.AeroLite;PresentationFramework.Classic;PresentationFramework.Luna;PresentationFramework.Royale;PresentationUI" />
    <None Include="@(_WpfShared->'$(WpfBin)%(Identity)/Release/net10.0/%(Identity).dll')" Pack="true" PackagePath="lib/wpf/" />
    <None Include="$(WpfBin)DirectWriteForwarderStub/Release/net10.0/DirectWriteForwarder.dll" Pack="true" PackagePath="lib/wpf/" />

    <!-- Desktop flavor extras: the real managed System.Printing + the cross-platform SystemEvents/Registry shims. -->
    <None Include="$(WpfBin)System.Printing.Managed/Release/net10.0/System.Printing.dll" Pack="true" PackagePath="lib/wpf-desktop/" />
    <None Include="$(WpfBin)Microsoft.Win32.SystemEvents/Release/net10.0/Microsoft.Win32.SystemEvents.dll" Pack="true" PackagePath="lib/wpf-desktop/" />
    <None Include="$(WpfBin)Microsoft.Win32.Registry/Release/net10.0/Microsoft.Win32.Registry.dll" Pack="true" PackagePath="lib/wpf-desktop/" />

    <!-- Browser flavor: JS-interop WebGPU + Accessibility ref. System.Printing is the same real
         assembly the desktop flavor gets; the contract-only reference assembly used to ship here
         because mono-wasm resolves XpsDocumentWriter EAGERLY while setting up DocumentViewerBase and
         the desktop cycle-breaker did not have the type at all. The real one has it, so both flavors
         can now use the same assembly and printing works in the browser rather than silently doing
         nothing (XpsDocumentWriter.Write was an empty method body in the ref). -->
    <None Include="$(WgpuInteropDir)Browser/bin/Release/net10.0/Microsoft.Wpf.Interop.WebGpu.dll" Pack="true" PackagePath="lib/wpf-browser/" Condition="Exists('$(WgpuInteropDir)Browser/bin/Release/net10.0/Microsoft.Wpf.Interop.WebGpu.dll')" />
    <None Include="$(WpfBin)System.Printing.Managed/Release/net10.0/System.Printing.dll" Pack="true" PackagePath="lib/wpf-browser/" />
    <None Include="$(WpfBin)Microsoft.Win32.SystemEvents/Release/net10.0/Microsoft.Win32.SystemEvents.dll" Pack="true" PackagePath="lib/wpf-browser/" />
    <None Include="$(WpfBin)Microsoft.Win32.Registry/Release/net10.0/Microsoft.Win32.Registry.dll" Pack="true" PackagePath="lib/wpf-browser/" />
    <None Include="$(WpfBin)System.Diagnostics.Process/Release/net10.0/System.Diagnostics.Process.dll" Pack="true" PackagePath="lib/wpf-browser/" />

    <!-- WinForms for UseWindowsForms apps, on EVERY desktop head (see Sdk.targets): the Mono
         System.Windows.Forms — which owns its own on-screen presentation, so Application.Run works —
         its vendored System.Drawing, Accessibility, and WindowsFormsIntegration for
         System.Windows.Forms.Integration.ElementHost (hosting a WPF tree inside a WinForms control).
         This is deliberately NOT a per-OS payload: Microsoft.WindowsDesktop.App's WinForms is never
         an option here, so Windows needs exactly the same assemblies as macOS and Linux. -->
    <None Include="$(WinFormsInteropDir)bin/Release/net10.0/System.Windows.Forms.dll" Pack="true" PackagePath="lib/wpf-winforms/" Condition="Exists('$(WinFormsInteropDir)bin/Release/net10.0/System.Windows.Forms.dll')" />
    <None Include="$(WinFormsInteropDir)sysdrawing/bin/Release/net10.0/Mono.System.Drawing.dll" Pack="true" PackagePath="lib/wpf-winforms/" Condition="Exists('$(WinFormsInteropDir)sysdrawing/bin/Release/net10.0/Mono.System.Drawing.dll')" />
    <!-- NOT $(WpfBin)WindowsFormsIntegration: that is the ARCADE build of the Windows-only original,
         which references the real System.Windows.Forms v10.0.0.0 and so cannot bind against the Mono
         one shipped beside it here. The WebGPU flavour under integration/ is the one built against
         our WinForms — see the Exists() guard below, which is what silently produced a package with
         no ElementHost/WindowsFormsHost in it while that project had never been built. -->
    <None Include="$(WinFormsInteropDir)integration/bin/Release/net10.0/WindowsFormsIntegration.dll" Pack="true" PackagePath="lib/wpf-winforms/" Condition="Exists('$(WinFormsInteropDir)integration/bin/Release/net10.0/WindowsFormsIntegration.dll')" />
    <None Include="$(WpfBin)Accessibility/Release/net10.0/Accessibility.dll" Pack="true" PackagePath="lib/wpf-winforms/" Condition="Exists('$(WpfBin)Accessibility/Release/net10.0/Accessibility.dll')" />

    <!-- WebView2, for BOTH UI stacks and on EVERY head.

         These carry the real package's strong-name identity (1.0.4022.49, token 2a8ab48044d2601e),
         so an application that already has <PackageReference Include="Microsoft.Web.WebView2"/>
         compiles and binds against them unchanged and runs on whatever engine the head actually has
         — WebView2 on Windows, WKWebView on macOS/iOS, and so on. Sdk.targets evicts the real
         package's assemblies in favour of these; see _WpfWebGpuStripWebView2Package there.

         Core and Wpf are packed for every desktop head; the WinForms control is packed beside them
         because it is only REFERENCED when UseWindowsForms is set (again, Sdk.targets), and a single
         folder keeps the three versions from drifting apart. -->
    <None Include="$(WpfBin)Microsoft.Web.WebView2.Core/Release/net10.0/Microsoft.Web.WebView2.Core.dll" Pack="true" PackagePath="lib/wpf-webview2/" Condition="Exists('$(WpfBin)Microsoft.Web.WebView2.Core/Release/net10.0/Microsoft.Web.WebView2.Core.dll')" />
    <None Include="$(WpfBin)Microsoft.Web.WebView2.Wpf/Release/net10.0/Microsoft.Web.WebView2.Wpf.dll" Pack="true" PackagePath="lib/wpf-webview2/" Condition="Exists('$(WpfBin)Microsoft.Web.WebView2.Wpf/Release/net10.0/Microsoft.Web.WebView2.Wpf.dll')" />
    <None Include="$(WpfBin)Microsoft.Web.WebView2.WinForms/Release/net10.0/Microsoft.Web.WebView2.WinForms.dll" Pack="true" PackagePath="lib/wpf-webview2-winforms/" Condition="Exists('$(WpfBin)Microsoft.Web.WebView2.WinForms/Release/net10.0/Microsoft.Web.WebView2.WinForms.dll')" />

    <!-- Native wgpu for the unix desktop heads. Each is packed only if staged on this machine
         (eng/fetch-wgpu.ps1 -Rid <rid>), so a package built on a Mac carries the macOS backend and
         one built on Linux carries the Linux one; Sdk.targets then picks by RID at consume time. -->
    <None Include="$(WgpuInteropDir)native/osx-arm64/lib/libwgpu_native.dylib" Pack="true" PackagePath="native/osx-arm64/" Condition="Exists('$(WgpuInteropDir)native/osx-arm64/lib/libwgpu_native.dylib')" />
    <None Include="$(WgpuInteropDir)native/osx-x64/lib/libwgpu_native.dylib" Pack="true" PackagePath="native/osx-x64/" Condition="Exists('$(WgpuInteropDir)native/osx-x64/lib/libwgpu_native.dylib')" />
    <None Include="$(WgpuInteropDir)native/linux-arm64/lib/libwgpu_native.so" Pack="true" PackagePath="native/linux-arm64/" Condition="Exists('$(WgpuInteropDir)native/linux-arm64/lib/libwgpu_native.so')" />
    <None Include="$(WgpuInteropDir)native/linux-x64/lib/libwgpu_native.so" Pack="true" PackagePath="native/linux-x64/" Condition="Exists('$(WgpuInteropDir)native/linux-x64/lib/libwgpu_native.so')" />
  </ItemGroup>

  <!-- ============================== windows head payload ============================== -->
  <ItemGroup Condition="'$(_HasWinRuntime)' == 'true'">
    <!-- Managed WPF (win-arm64 fork build). Curated to the WPF surface only — System.*/Microsoft.*
         that belong to NETCore.App or arrive as PackageReferences are intentionally excluded so
         they don't shadow the runtime with a stale copy. -->
    <_WpfWin Include="PresentationFramework;PresentationCore;WindowsBase;System.Xaml;DirectWriteForwarder;ReachFramework;System.Printing;PresentationUI;System.Windows.Presentation;System.Windows.Controls.Ribbon;System.Windows.Input.Manipulations;System.Windows.Primitives;UIAutomationTypes;UIAutomationProvider;UIAutomationClient;UIAutomationClientSideProviders;PresentationFramework.Fluent;PresentationFramework.Aero2;PresentationFramework.Aero;PresentationFramework.AeroLite;PresentationFramework.Classic;PresentationFramework.Luna;PresentationFramework.Royale" />
    <None Include="@(_WpfWin->'$(WpfWinRuntimeDir)%(Identity).dll')" Pack="true" PackagePath="lib/wpf-windows/" />

    <!-- The MSAA interop assembly, from the fork build rather than from $(WpfWinRuntimeDir).
         Everything else in the windows head comes out of the staged runtime directory, but that
         directory is laid out like Microsoft.WindowsDesktop.App and this is the one assembly in it
         the fork did not used to build. It does now (src/Microsoft.DotNet.Wpf/src/Accessibility),
         so the head has no WindowsDesktop framework assembly left in it. Only UIAutomationClient
         and UIAutomationClientSideProviders need it. -->
    <None Include="$(WpfBin)Accessibility/Release/net10.0/Accessibility.dll" Pack="true" PackagePath="lib/wpf-windows/"
          Condition="Exists('$(WpfBin)Accessibility/Release/net10.0/Accessibility.dll')" />

    <!-- No WPF native runtime. wpfgfx_cor3, PresentationNative_cor3 and PenImc_cor3 used to be packed
         here; nothing loads them any more and shipping them only invited something to start again:
           * wpfgfx    - composition is the managed WebGPU engine, geometry/bounds and text are managed,
                         and media now goes through WindowsMediaBackend (Media Foundation) instead of
                         the milcore media player, whose frames the managed compositor could not see.
           * PresNative- Line Services, PTS and OS-version checks are managed; the speller prefers WinRT
                         and the hyphenator degrades to no-hyphenation if it is absent.
           * PenImc    - stylus/touch runs on the WM_POINTER stack, which needs no native helper
                         (StylusLogic.IsPointerStackEnabled).
         vcruntime140_cor3 went with them: it was only there to satisfy the three above. -->

    <!-- WebGPU native runtime (wgpu-native + ANGLE GL), win-arm64. -->
    <None Include="$(WgpuWinNativeDir)wgpu_native.dll" Pack="true" PackagePath="native/win-arm64/" Condition="Exists('$(WgpuWinNativeDir)wgpu_native.dll')" />
    <None Include="$(WgpuWinNativeDir)libEGL.dll" Pack="true" PackagePath="native/win-arm64/" Condition="Exists('$(WgpuWinNativeDir)libEGL.dll')" />
    <None Include="$(WgpuWinNativeDir)libGLESv2.dll" Pack="true" PackagePath="native/win-arm64/" Condition="Exists('$(WgpuWinNativeDir)libGLESv2.dll')" />

    <!-- The WebView2 loader, which is the ONLY native dependency the web view has on Windows: it
         exports CreateCoreWebView2EnvironmentWithOptions, and WindowsWebViewBackend P/Invokes it to
         start the Edge runtime. The runtime itself is an OS component (preinstalled on Windows 11)
         and is not shipped here — only this ~150 KB shim is.

         Staged the same way wgpu-native is (see WebView2LoaderDir), so the pack is Exists()-gated and
         a machine without it produces a diagnosable error rather than a package whose every
         web-hosting app dies with DllNotFoundException. -->
    <None Include="$(WebView2LoaderDir)WebView2Loader.dll" Pack="true" PackagePath="native/win-arm64/" Condition="Exists('$(WebView2LoaderDir)WebView2Loader.dll')" />
  </ItemGroup>

  <!-- Fail early with a readable message instead of packing a broken SDK. -->
  <Target Name="WpfWebGpuValidateInputs" BeforeTargets="GenerateNuspec">
    <Error Condition="'$(_HasForkNet10)' != 'true' and '$(_HasWinRuntime)' != 'true'"
           Text="Nothing to pack: neither the net10.0 fork build ($(WpfBin)PresentationFramework/Release/net10.0/) nor a staged win-arm64 runtime ($(WpfWinRuntimeDir)) is present. Build the fork or set WpfWinRuntimeDir." />
    <Error Condition="'$(_HasWinRuntime)' == 'true' and !Exists('$(WpfBin)Accessibility/Release/net10.0/Accessibility.dll')"
           Text="The windows head needs the fork-built Accessibility.dll ($(WpfBin)Accessibility/Release/net10.0/). Build the fork; do NOT substitute the WindowsDesktop framework copy." />
    <!-- The three WebView2 assemblies move together or not at all: they share an identity and a
         version, and a package carrying only some of them resolves half an application's references
         to ours and half to the real (Windows-only) package, which fails at run time off Windows in
         a way that points nowhere near this SDK. -->
    <Error Condition="'$(_HasForkNet10)' == 'true' and
                      Exists('$(WpfBin)Microsoft.Web.WebView2.Core/Release/net10.0/Microsoft.Web.WebView2.Core.dll') and
                      !Exists('$(WpfBin)Microsoft.Web.WebView2.Wpf/Release/net10.0/Microsoft.Web.WebView2.Wpf.dll')"
           Text="Microsoft.Web.WebView2.Core was built but Microsoft.Web.WebView2.Wpf was not. Build src/Microsoft.DotNet.Wpf/src/WebView2/Microsoft.Web.WebView2.Wpf (and .WinForms); shipping one without the other resolves half an app's references to the real Windows-only package." />

    <Error Condition="'$(_HasWinRuntime)' == 'true' and
                      Exists('$(WpfBin)Microsoft.Web.WebView2.Core/Release/net10.0/Microsoft.Web.WebView2.Core.dll') and
                      !Exists('$(WebView2LoaderDir)WebView2Loader.dll')"
           Text="The windows head packs the WebView2 assemblies but has no WebView2Loader.dll under $(WebView2LoaderDir). Restore the Microsoft.Web.WebView2 package or set WebView2LoaderDir. Without it every web view on Windows fails at startup with DllNotFoundException, exactly as a missing wgpu_native.dll does." />

    <Error Condition="'$(_HasWinRuntime)' == 'true' and !Exists('$(WgpuWinNativeDir)wgpu_native.dll')"
           Text="The windows head has no WebGPU backend: no wgpu_native.dll under $(WgpuWinNativeDir). Build samples/wpf-webgpu-gallery (which stages wgpu-native + ANGLE) or set WgpuWinNativeDir. Packing without it produces an SDK whose apps all fail at startup with DllNotFoundException." />
    <Warning Condition="'$(_HasWinRuntime)' == 'true' and !Exists('$(WgpuWinNativeDir)libEGL.dll')"
             Text="No ANGLE runtime under $(WgpuWinNativeDir) — the windows head will have no OpenGL backend, which is the only one available on some machines (e.g. a VM with a virtualized GPU)." />
    <Error Condition="!Exists('$(WpfRepoRoot)artifacts/packaging/Release/Microsoft.NET.Sdk.WindowsDesktop/tools/net10.0/PresentationBuildTasks.dll')"
           Text="PresentationBuildTasks not packaged: missing artifacts/packaging/Release/Microsoft.NET.Sdk.WindowsDesktop/tools/net10.0/PresentationBuildTasks.dll." />
    <Warning Condition="'$(_HasForkNet10)' != 'true'"
             Text="net10.0 fork build absent — packing WITHOUT the unix/macOS + browser heads (windows head only)." />
    <Warning Condition="'$(_HasWinRuntime)' != 'true'"
             Text="win-arm64 runtime absent ($(WpfWinRuntimeDir)) — packing WITHOUT the windows head." />
  </Target>

</Project>
