<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs inside the launched app, before its Main, as a startup hook (STARTUP_HOOKS in the
       runtimeconfig wpfmac generates; never an environment variable, so a process the app starts
       does not inherit it). Everything it does is generic: nothing here knows which app it is in. -->
  <PropertyGroup>
    <AssemblyName>WpfMac.Bootstrap</AssemblyName>
    <RootNamespace>WpfMac.Bootstrap</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
