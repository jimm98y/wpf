<Project>
  <!-- Fixtures are ordinary Windows apps built with the STOCK SDK, exactly as a user's app would be:
       net10.0-windows + UseWPF/UseWindowsForms. They know nothing about wpfmac or the WebGPU stack.
       EnableWindowsTargeting lets them build on macOS/Linux. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
</Project>
