<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for wpfmac and the macOS shims: dotnet test tools/WpfMac/tests/WpfMac.Tests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.0.0" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="1.7.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../WpfMac.Launcher/WpfMac.Launcher.csproj" />
    <ProjectReference Include="../../WpfMac.ComRewrite/WpfMac.ComRewrite.csproj" />
    <!-- rewritten by ComRewriterTests, which load the result on their own -->
    <ProjectReference Include="../ComImportFixture/ComImportFixture.csproj" ReferenceOutputAssembly="false" />
    <AssemblyMetadata Include="ComImportFixture" Value="$(MSBuildThisFileDirectory)../ComImportFixture/bin/$(Configuration)/net10.0/ComImportFixture.dll" />
    <!-- The generated stand-in DLL for user32 (Windows), tested by loading what it writes. -->
    <Compile Include="../../WpfMac.Bootstrap/Win32/ShimImage.cs" Link="Bootstrap/ShimImage.cs" />
    <Compile Include="../../WpfMac.Bootstrap/Win32/Direct3DShim.cs" Link="Bootstrap/Direct3DShim.cs" />
    <Compile Include="../../WpfMac.Bootstrap/CompatLog.cs" Link="Bootstrap/CompatLog.cs" />
    <ProjectReference Include="$(WpfMacRepoRoot)shims/Microsoft.Win32.Registry/Microsoft.Win32.Registry.csproj" Aliases="RegistryShim" />
    <ProjectReference Include="$(WpfMacRepoRoot)shims/System.Management/System.Management.csproj" />
    <ProjectReference Include="$(WpfMacRepoRoot)shims/System.ServiceProcess.ServiceController/System.ServiceProcess.ServiceController.csproj" />
    <ProjectReference Include="$(WpfMacRepoRoot)shims/System.Security.Cryptography.ProtectedData/System.Security.Cryptography.ProtectedData.csproj" />
    <ProjectReference Include="$(WpfMacRepoRoot)shims/System.Diagnostics.PerformanceCounter/System.Diagnostics.PerformanceCounter.csproj" />
    <ProjectReference Include="$(WpfMacRepoRoot)shims/System.Diagnostics.EventLog/System.Diagnostics.EventLog.csproj" />
  </ItemGroup>

</Project>
