<Project>
  <!-- The launcher is built outside the repo's Arcade build, like shims/ and samples/: this file is
       deliberately the nearest Directory.Build.props, so the root one (and its code-style-as-error
       analyzers and Arcade output layout) is never imported. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- The repo's .editorconfig raises analyzer suggestions to errors for the product code; like the
         SDK pack project, these tools opt out. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <WpfWebGpuRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../..'))</WpfWebGpuRepoRoot>
  </PropertyGroup>
</Project>
