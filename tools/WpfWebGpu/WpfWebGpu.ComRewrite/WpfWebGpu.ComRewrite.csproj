<Project Sdk="Microsoft.NET.Sdk">

  <!-- The COM-import rewriter (Documentation/comimport-rewriter.md) and the P/Invoke rewriter
       (Documentation/pinvoke-rewriter.md): rewrite an app assembly's [ComImport] interfaces and its
       Windows P/Invokes onto the stack's managed implementations. Used by the launcher when it prepares
       an app, by the bootstrap when it loads one, and by the build of a bundled head. Mono.Cecil: MIT
       (its notice ships in the overlay with MonoMod's). -->
  <PropertyGroup>
    <AssemblyName>WpfWebGpu.ComRewrite</AssemblyName>
    <RootNamespace>WpfWebGpu.ComRewrite</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <ProjectReference Include="../WpfWebGpu.ComInterop/WpfWebGpu.ComInterop.csproj" />
  </ItemGroup>

</Project>
