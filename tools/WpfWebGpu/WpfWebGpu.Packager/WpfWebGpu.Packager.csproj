<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Packager's engine: a Windows installation (its Program Files folder, optionally its ProgramData
       folders and a regedit export) into installers and apps for each head. Used by `wpfrun package` and
       by the Packager app. Pure managed code: nothing here calls an external tool. -->
  <PropertyGroup>
    <AssemblyName>WpfWebGpu.Packager</AssemblyName>
    <RootNamespace>WpfWebGpu.Packager</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WpfWebGpu.Tests" />
    <InternalsVisibleTo Include="wpfrun" />
  </ItemGroup>

  <ItemGroup>
    <!-- the rewrite of an app's assemblies onto the stack, as a bundled head's build runs it -->
    <ProjectReference Include="../WpfWebGpu.ComRewrite/WpfWebGpu.ComRewrite.csproj" />
    <!-- the service manager's database the desktop packages install (services.json) -->
    <ProjectReference Include="../WpfWebGpu.Services/WpfWebGpu.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CMS for Authenticode (Microsoft's, MIT) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- the stack's PNG decoder (every colour type, every filter), for the icons -->
    <Compile Include="$(WpfWebGpuRepoRoot)src/Microsoft.DotNet.Wpf/src/WgpuInterop/Composition/PngReader.cs" Link="Shared/PngReader.cs" />
    <!-- Setup.exe's payload format, which the Windows packager writes and Setup reads -->
    <Compile Include="../WpfWebGpu.Setup/Payload.cs" Link="Shared/Payload.cs" />
  </ItemGroup>

</Project>
