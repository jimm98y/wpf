<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for wpfrun and the macOS shims: dotnet test tools/WpfWebGpu/tests/WpfWebGpu.Tests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.0.0" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="1.7.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../WpfWebGpu.Launcher/WpfWebGpu.Launcher.csproj" />
    <ProjectReference Include="../../WpfWebGpu.ComRewrite/WpfWebGpu.ComRewrite.csproj" />
    <!-- rewritten by ComRewriterTests, which load the result on their own -->
    <ProjectReference Include="../ComImportFixture/ComImportFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../ComUserFixture/ComUserFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../ComReleaserFixture/ComReleaserFixture.csproj" ReferenceOutputAssembly="false" />
    <AssemblyMetadata Include="ComImportFixture" Value="$(MSBuildThisFileDirectory)../ComImportFixture/bin/$(Configuration)/net10.0/ComImportFixture.dll" />
    <!-- rewritten by PInvokeRewriterTests onto PInvokeImplFixture's implementations -->
    <ProjectReference Include="../PInvokeFixture/PInvokeFixture.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../PInvokeImplFixture/PInvokeImplFixture.csproj" ReferenceOutputAssembly="false" />
    <AssemblyMetadata Include="PInvokeFixture" Value="$(MSBuildThisFileDirectory)../PInvokeFixture/bin/$(Configuration)/net10.0/PInvokeFixture.dll" />
    <AssemblyMetadata Include="PInvokeImplFixture" Value="$(MSBuildThisFileDirectory)../PInvokeImplFixture/bin/$(Configuration)/net10.0/PInvokeImplFixture.dll" />
    <!-- the real export table, when WpfWebGpu.Win32 has been built (it needs the WebGPU SDK) -->
    <AssemblyMetadata Include="WpfWebGpuWin32" Value="$(MSBuildThisFileDirectory)../../WpfWebGpu.Win32/bin/$(Configuration)/net10.0/WpfWebGpu.Win32.dll" />
    <Compile Include="../../WpfWebGpu.Bootstrap/CompatLog.cs" Link="Bootstrap/CompatLog.cs" />
    <ProjectReference Include="$(WpfWebGpuRepoRoot)shims/Microsoft.Win32.Registry/Microsoft.Win32.Registry.csproj" Aliases="RegistryShim" />
    <ProjectReference Include="$(WpfWebGpuRepoRoot)shims/System.Management/System.Management.csproj" />
    <ProjectReference Include="$(WpfWebGpuRepoRoot)shims/System.ServiceProcess.ServiceController/System.ServiceProcess.ServiceController.csproj" />
    <ProjectReference Include="$(WpfWebGpuRepoRoot)shims/System.Security.Cryptography.ProtectedData/System.Security.Cryptography.ProtectedData.csproj" />
    <!-- the browser's System.Net.Requests and System.Net.WebClient, in place of the framework's for this process
         (NetShimTests checks them against what .NET's own do) -->
    <ProjectReference Include="$(WpfWebGpuRepoRoot)shims/System.Net.Requests/System.Net.Requests.csproj" />
    <ProjectReference Include="$(WpfWebGpuRepoRoot)shims/System.Net.WebClient/System.Net.WebClient.csproj" />
    <ProjectReference Include="$(WpfWebGpuRepoRoot)shims/System.Diagnostics.PerformanceCounter/System.Diagnostics.PerformanceCounter.csproj" />
    <ProjectReference Include="$(WpfWebGpuRepoRoot)shims/System.Diagnostics.EventLog/System.Diagnostics.EventLog.csproj" />
    <!-- a framework member: at its higher version it replaces the shared framework's for this process -->
    <ProjectReference Include="$(WpfWebGpuRepoRoot)shims/System.Security.Principal.Windows/System.Security.Principal.Windows.csproj" Aliases="PrincipalShim" />
  </ItemGroup>

  <!-- compiled against the shims' System.Net.Requests and System.Net.WebClient, not the framework's -->
  <Target Name="WpfWebGpuNetShimsOnly" AfterTargets="ResolveTargetingPackAssets">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'System.Net.Requests' or '%(Filename)' == 'System.Net.WebClient'" />
    </ItemGroup>
  </Target>

</Project>
