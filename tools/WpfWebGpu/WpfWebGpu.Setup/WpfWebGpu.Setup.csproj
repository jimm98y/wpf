<Project Sdk="Microsoft.NET.Sdk">

  <!-- Setup.exe: the Windows installer the Packager writes: this program with the installation appended as a
       zip (Payload.cs). Published self-contained, one file, per architecture (wpfrun pack, for each Windows RID):
       nothing needs to be installed for it to run. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Setup</AssemblyName>
    <RootNamespace>WpfWebGpu.Setup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

</Project>
