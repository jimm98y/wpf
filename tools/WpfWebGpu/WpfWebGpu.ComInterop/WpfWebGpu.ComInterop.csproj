<Project Sdk="Microsoft.NET.Sdk">

  <!-- The runtime half of the COM-import rewriter (Documentation/comimport-rewriter.md): what an app
       assembly rewritten by wpfrun calls instead of built-in COM interop. Shipped in the overlay; a
       rewritten assembly references it by name. -->
  <PropertyGroup>
    <AssemblyName>WpfWebGpu.ComInterop</AssemblyName>
    <RootNamespace>WpfWebGpu.ComInterop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);APPHOST_INTERNAL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- the app an executable starts (App_ARM64.exe's apphost starts App.dll), as the Packager reads it -->
    <Compile Include="../WpfWebGpu.Packager/AppHost.cs" Link="Shared/AppHost.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- the types of a stand-in's signature only (an ASP.NET app's PhysicalFileProvider): an app that calls one has
         the assembly (its shared framework), and no other app loads it -->
    <PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="10.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
