<?xml version="1.0" encoding="utf-8"?>
<!-- The payload is built with WpfWebGpu.Sdk, which eng/build-sdk.sh packs into artifacts/local-feed. -->
<configuration>
  <packageSources>
    <clear />
    <add key="wpfwebgpu-local-feed" value="../../artifacts/local-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
