<Project Sdk="Microsoft.NET.Sdk">

  <!-- wpfrun: runs an unmodified net10.0-windows WPF/WinForms app on the WebGPU stack without touching
       its folder. See Documentation/running-prebuilt-apps.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>wpfrun</AssemblyName>
    <RootNamespace>WpfWebGpu</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WpfWebGpu.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- `wpfrun reg`: the registry apps see under wpfrun is the shim's store, so it is read and
         written through the shim itself (it wins over the framework's copy by version). -->
    <ProjectReference Include="../../../shims/Microsoft.Win32.Registry/Microsoft.Win32.Registry.csproj" Aliases="RegistryShim" />
    <!-- the COM-import rewrite of app assemblies (ComImportStep.cs) -->
    <ProjectReference Include="../WpfWebGpu.ComRewrite/WpfWebGpu.ComRewrite.csproj" />
    <!-- `wpfrun package`: the Packager's engine (and the .reg parser `wpfrun reg` shares with it) -->
    <ProjectReference Include="../WpfWebGpu.Packager/WpfWebGpu.Packager.csproj" />
    <!-- `wpfrun httpsys`: the machine's http.sys service (WpfWebGpu.HttpSys), on ASP.NET Core's Kestrel -->
    <ProjectReference Include="../WpfWebGpu.HttpSys/WpfWebGpu.HttpSys.csproj" />
    <!-- `wpfrun scm`: the machine's service manager (WpfWebGpu.Services) -->
    <ProjectReference Include="../WpfWebGpu.Services/WpfWebGpu.Services.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
