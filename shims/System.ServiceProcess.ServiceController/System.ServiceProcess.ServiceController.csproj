<Project Sdk="Microsoft.NET.Sdk">

  <!-- Replacement for the System.ServiceProcess.ServiceController package's runtime assembly, for
       macOS and Linux. The package's non-Windows build throws PlatformNotSupportedException; this one is
       the client of the machine's service manager (WpfWebGpu.Services): the services the installation
       registered, their state from launchd or systemd, starting and stopping them as each one's
       security descriptor allows, and a name that is not installed failing as on Windows
       (InvalidOperationException over Win32Exception 1060). A service (ServiceBase) runs as the service manager there runs it (ServiceBase.cs):
       started, then stopped when the manager stops it (systemd's or launchd's SIGTERM).

       Public surface: Surface.g.cs (../Surface/gen-surface.sh) less implemented.txt. Same identity
       as the package, AssemblyVersion above it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.ServiceProcess.ServiceController</AssemblyName>
    <RootNamespace>System.ServiceProcess</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyVersion>10.0.9999.0</AssemblyVersion>
    <FileVersion>10.0.9999.0</FileVersion>
    <Version>10.0.9999</Version>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>msft.publickey</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CA1416;SYSLIB0051;CS0108;CS0114;CS0618;CS0672;CS8597;CS8625</NoWarn>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- ServiceBase.EventLog. Compiled against the package; binds whatever EventLog the app runs with. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.15" />
    <ProjectReference Include="../../tools/WpfWebGpu/WpfWebGpu.Services/WpfWebGpu.Services.csproj" />
  </ItemGroup>

</Project>
