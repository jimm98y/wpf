<Project Sdk="Microsoft.NET.Sdk">

  <!-- Replacement for the System.Security.Cryptography.ProtectedData package's runtime assembly, for
       macOS, where the package throws PlatformNotSupportedException. It keeps DPAPI's contract:
       data protected for the current user (or the machine) round-trips, optional entropy must match,
       tampered or foreign data is refused with CryptographicException, using AES-GCM under a key
       of its own: 32 random bytes per scope in WPFWEBGPU_DPAPI_DIR (wpfrun points that at its state
       folder), else ~/Library/Application Support/WpfWebGpu/DataProtection, readable by the user
       only. Blobs are not Windows DPAPI blobs: what a Windows machine protected cannot be read here,
       which is also true between two Windows machines.

       Public surface: Surface.g.cs (../Surface/gen-surface.sh) less implemented.txt. Same identity
       as the package, AssemblyVersion above it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Security.Cryptography.ProtectedData</AssemblyName>
    <RootNamespace>System.Security.Cryptography</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyVersion>10.0.9999.0</AssemblyVersion>
    <FileVersion>10.0.9999.0</FileVersion>
    <Version>10.0.9999</Version>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>msft.publickey</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CA1416;CS8632</NoWarn>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
