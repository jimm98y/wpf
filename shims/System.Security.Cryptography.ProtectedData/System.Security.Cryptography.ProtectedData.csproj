<Project Sdk="Microsoft.NET.Sdk">

  <!-- Replacement for the System.Security.Cryptography.ProtectedData package's runtime assembly, for
       macOS and the browser, where the package throws PlatformNotSupportedException. It keeps DPAPI's
       contract: data protected for the current user (or the machine) round-trips, optional entropy must
       match, tampered or foreign data is refused with CryptographicException. Blobs have DPAPI's layout,
       under master keys of its own (ProtectedData.cs): in the login keychain on macOS, in the origin's
       private file system in the browser, in WPFWEBGPU_DPAPI_DIR when that is set. What a Windows
       machine protected cannot be read here, which is also true between two Windows machines.

       AES is the managed one WpfWebGpu.ComInterop's Aes stand-in uses, compiled in from there: the
       browser's .NET refuses Aes and AesGcm, and this assembly may depend on the framework only.

       Public surface: Surface.g.cs (../Surface/gen-surface.sh) less implemented.txt. Same identity
       as the package, AssemblyVersion above it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Security.Cryptography.ProtectedData</AssemblyName>
    <RootNamespace>System.Security.Cryptography</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyVersion>10.0.9999.0</AssemblyVersion>
    <FileVersion>10.0.9999.0</FileVersion>
    <Version>10.0.9999</Version>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>msft.publickey</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CA1416;CS8632</NoWarn>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../tools/WpfWebGpu/WpfWebGpu.ComInterop/Crypto/AesCore.cs" Link="AesCore.cs" />
  </ItemGroup>

</Project>
