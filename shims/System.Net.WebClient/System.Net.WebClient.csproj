<Project Sdk="Microsoft.NET.Sdk">

  <!-- Browser replacement for System.Net.WebClient, whose wasm build throws PlatformNotSupportedException
       from its constructor on. WebClient as .NET has it, over WebRequest (the System.Net.Requests shim,
       which is HttpClient underneath): GetWebRequest and GetWebResponse are where an app's subclass sees
       and changes each request, the synchronous members wait for the response, the ...Async ones run on
       the thread pool and raise their events on the caller's synchronization context, and the
       ...TaskAsync ones are those. Same strong-name identity as the real assembly, version above it;
       bundled for the browser head only (Sdk.targets).

       Public surface: Surface.g.cs (../Surface/gen-surface.sh . System.Net.WebClient framework) less
       implemented.txt, which lists the types written by hand here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Net.WebClient</AssemblyName>
    <RootNamespace>System.Net</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyVersion>10.0.9999.0</AssemblyVersion>
    <FileVersion>10.0.9999.0</FileVersion>
    <Version>10.0.9999</Version>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>msft.publickey</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CA1416;CS0067;CS0618;SYSLIB0014;SYSLIB0051;CS8632</NoWarn>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../tools/WpfWebGpu/WpfWebGpu.ComInterop/WindowsPathCore.cs" Link="WindowsPathCore.cs" />
  </ItemGroup>

  <!-- This assembly is the framework's System.Net.WebClient: compiled without the reference assembly of
       that name, so its types are these. -->
  <Target Name="WpfWebGpuDropOwnReference" AfterTargets="ResolveTargetingPackAssets">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == '$(AssemblyName)'" />
    </ItemGroup>
  </Target>

</Project>
