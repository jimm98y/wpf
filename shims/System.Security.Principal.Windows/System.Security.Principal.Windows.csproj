<Project Sdk="Microsoft.NET.Sdk">

  <!-- macOS replacement for System.Security.Principal.Windows, whose non-Windows build throws
       PlatformNotSupportedException from every member: WindowsIdentity.GetCurrent() included, which
       Workbench's installer calls to work out whom to GRANT its databases to, and the install died
       there. The Mac user is a local Windows account of this machine (Principal.cs). Same identity
       as the framework assembly at a higher version, so the host binds it for every reference. -->

  
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Security.Principal.Windows</AssemblyName>
    <RootNamespace>System.Security.Principal</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Higher than the shared-framework 10.0.0.0 for the same reason as the Registry shim: RAR must
         not mistake it for the in-box assembly, so it is copied app-local and wins name unification. -->
    <AssemblyVersion>10.0.9999.0</AssemblyVersion>
    <FileVersion>10.0.9999.0</FileVersion>
    <Version>10.0.9999</Version>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>msft.publickey</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CA1416;CS0067</NoWarn>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>

