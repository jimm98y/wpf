<Project Sdk="Microsoft.NET.Sdk">

  <!-- Replacement for the System.Management package's runtime assembly, for macOS. The package's own
       non-Windows build throws PlatformNotSupportedException from every member; this one answers WQL
       over root\cimv2 from what the Mac actually has (Win32_ComputerSystem, _Processor, _BaseBoard,
       _BIOS, _OperatingSystem, _LogicalDisk, _NetworkAdapter[Configuration], _VideoController, ...)
       and reports true state for the rest: Win32_Service has no instances, another namespace is
       InvalidNamespace, as on a Windows machine without that product installed.

       The public surface is the package's, generated (Surface.g.cs, see ../Surface/gen-surface.sh)
       less the members listed in implemented.txt, which the other files implement. Same identity as
       the package, AssemblyVersion above it so it wins over the copy an app ships (wpfrun's overlay
       references it for macOS RIDs only). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Management</AssemblyName>
    <RootNamespace>System.Management</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>10.0.9999.0</AssemblyVersion>
    <FileVersion>10.0.9999.0</FileVersion>
    <Version>10.0.9999</Version>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>msft.publickey</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The generated surface: obsolete serialization members, hidden inherited members. -->
    <NoWarn>CA1416;SYSLIB0051;CS0108;CS0114;CS0618;CS0672;CS8597;CS8625</NoWarn>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CodeDom" Version="10.0.10" />
  </ItemGroup>

</Project>
