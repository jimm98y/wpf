<Project Sdk="Microsoft.NET.Sdk">

  <!-- Replacement for the System.Windows.Extensions package's runtime assembly, on every OS (Windows too): its
       SoundPlayer and SystemSounds play through the OS's audio (winmm on Windows, AppKit on macOS, the desktop's
       player on Linux), X509Certificate2UI shows Windows' certificate dialogs on Windows, XamlAccessLevel is the
       data it always was. The package's own non-Windows build throws for all of them.

       Public surface: Surface.g.cs (../Surface/gen-surface.sh) less implemented.txt. Same identity as the
       package (ECMA key), AssemblyVersion above it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Windows.Extensions</AssemblyName>
    <RootNamespace>System.Media</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyVersion>10.0.9999.0</AssemblyVersion>
    <FileVersion>10.0.9999.0</FileVersion>
    <Version>10.0.9999</Version>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>ecma.publickey</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CA1416;SYSLIB0051;CS0108;CS0114;CS0618;CS0672;CS8597;CS8625</NoWarn>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
