<Project Sdk="Microsoft.NET.Sdk">

  <!-- Replacement for the framework's System.Security.AccessControl off Windows, whose non-Windows build throws
       PlatformNotSupportedException from every member: an app that makes a mutex, a file or a registry key with an
       access control list (a licence tool's global mutex) died there. Microsoft's own implementation (Runtime/,
       dotnet/runtime, MIT): ACEs, ACLs, security descriptors, rules, the ObjectSecurity family, with what reads
       and writes an object's descriptor through Win32 kept in memory instead (Win32.cs): the descriptor an app sets
       is the one it reads back, and nothing enforces it, as on a file system without ACLs. Same identity as the
       framework assembly at a higher version, so the host binds it for every reference. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Security.AccessControl</AssemblyName>
    <RootNamespace>System.Security.AccessControl</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>10.0.9999.0</AssemblyVersion>
    <FileVersion>10.0.9999.0</FileVersion>
    <Version>10.0.9999</Version>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>msft.publickey</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CA1416;CS0067;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;SYSLIB0003;SYSLIB0051</NoWarn>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- the SIDs the ACEs hold: the stand-in for System.Security.Principal.Windows -->
    <ProjectReference Include="../System.Security.Principal.Windows/System.Security.Principal.Windows.csproj" />
  </ItemGroup>

  <!-- compiled against the stand-ins, not the framework's throwing copies of the same names -->
  <Target Name="WpfWebGpuShimsOnly" AfterTargets="ResolveTargetingPackAssets">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'System.Security.Principal.Windows' or '%(Filename)' == 'System.Security.AccessControl'" />
    </ItemGroup>
  </Target>

</Project>
