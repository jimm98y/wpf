<Project Sdk="Microsoft.NET.Sdk">

  <!-- Replacement for the System.Threading.AccessControl package off Windows, whose non-Windows build throws
       PlatformNotSupportedException: a mutex, event or semaphore made with an access control list (a licence
       tool's global mutex). Microsoft's own security classes (Runtime/, dotnet/runtime, MIT) on the
       System.Security.AccessControl stand-in; the objects made and opened by name as .NET makes them (Acl.cs),
       their security kept as that stand-in keeps it. Same identity as the package, at a higher version. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Threading.AccessControl</AssemblyName>
    <RootNamespace>System.Threading</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>10.0.9999.0</AssemblyVersion>
    <FileVersion>10.0.9999.0</FileVersion>
    <Version>10.0.9999</Version>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>msft.publickey</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CA1416;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../System.Security.AccessControl/System.Security.AccessControl.csproj" />
    <ProjectReference Include="../System.Security.Principal.Windows/System.Security.Principal.Windows.csproj" />
  </ItemGroup>

  <Target Name="WpfWebGpuShimsOnly" AfterTargets="ResolveTargetingPackAssets">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'System.Security.Principal.Windows' or '%(Filename)' == 'System.Security.AccessControl'" />
    </ItemGroup>
  </Target>

</Project>
