<Project Sdk="Microsoft.NET.Sdk">

  <!-- Replacement for the System.Threading.AccessControl package, a Windows Desktop Runtime member, on every OS: a
       mutex, event or semaphore made with an access control list (a licence tool's global mutex). On Windows the
       kernel's own objects with the list as their security descriptor (WindowsAcl.cs); elsewhere, where the
       package throws PlatformNotSupportedException, made and opened by name as .NET makes them, the list kept
       with the System.Security.AccessControl stand-in (not enforced). Microsoft's own security classes
       (Runtime/, dotnet/runtime, MIT), compiled against the framework's System.Security.AccessControl (on
       Windows the framework's own, which is not replaced there). Same identity as the package, at a higher
       version. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Threading.AccessControl</AssemblyName>
    <RootNamespace>System.Threading</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>10.0.9999.0</AssemblyVersion>
    <FileVersion>10.0.9999.0</FileVersion>
    <Version>10.0.9999</Version>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>msft.publickey</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CA1416;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
