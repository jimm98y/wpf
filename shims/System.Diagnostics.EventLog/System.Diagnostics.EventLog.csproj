<Project Sdk="Microsoft.NET.Sdk">

  <!-- Replacement for the System.Diagnostics.EventLog package's runtime assembly, on every OS (Windows
       too). Entries are the OS's log's: written there and read back from there (OsLog: the Event Log on
       Windows, journald on Linux, the unified log on macOS), so a log holds what every program wrote; where
       the OS keeps none (Android, iOS), the process keeps its own. Sources and the logs they create are
       registered where Windows registers them, HKLM\SYSTEM\CurrentControlSet\Services\EventLog\<log>\<source>
       (on Windows the registry itself, elsewhere the Microsoft.Win32.Registry shim's file store). Each entry
       is also mirrored to wpfrun's compatibility log. The Eventing.Reader API stays unsupported.

       Public surface: Surface.g.cs (../Surface/gen-surface.sh) less implemented.txt. Same identity
       as the package (ECMA key), AssemblyVersion above it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Diagnostics.EventLog</AssemblyName>
    <RootNamespace>System.Diagnostics</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyVersion>10.0.9999.0</AssemblyVersion>
    <FileVersion>10.0.9999.0</FileVersion>
    <Version>10.0.9999</Version>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>ecma.publickey</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CA1416;SYSLIB0051;CS0108;CS0114;CS0618;CS0672;CS8597;CS8625</NoWarn>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>


</Project>
