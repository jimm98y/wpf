<Project Sdk="Microsoft.NET.Sdk">

  <!-- Replacement for the System.Diagnostics.PerformanceCounter package's runtime assembly, for
       macOS, where the package throws PlatformNotSupportedException. Categories an app creates live
       in its own process (a counter it writes, it can read back); the standard categories Processor,
       Memory, Process and System are read-only and report this machine's live values. A category or
       counter that does not exist fails as on Windows, where an app's installer has not registered it.

       Public surface: Surface.g.cs (../Surface/gen-surface.sh) less implemented.txt. Same identity
       as the package (ECMA key), AssemblyVersion above it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Diagnostics.PerformanceCounter</AssemblyName>
    <RootNamespace>System.Diagnostics</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyVersion>10.0.9999.0</AssemblyVersion>
    <FileVersion>10.0.9999.0</FileVersion>
    <Version>10.0.9999</Version>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>ecma.publickey</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CA1416;SYSLIB0051;CS0108;CS0114;CS0618;CS0672;CS8597;CS8625</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>


</Project>
