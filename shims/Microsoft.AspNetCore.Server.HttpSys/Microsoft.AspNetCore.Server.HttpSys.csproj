<Project Sdk="Microsoft.NET.Sdk">

  <!-- Replacement for the shared framework's Microsoft.AspNetCore.Server.HttpSys off Windows, whose every member
       throws PlatformNotSupportedException there: a web host that serves through http.sys (UseHttpSys and its URL
       prefixes). Kestrel serves instead, each prefix an endpoint of its own, with http.sys's routing: a request is
       the longest matching prefix's, its path base the prefix's path, and one no prefix claims is answered 404.
       Same identity as the framework assembly at a higher version, so the host binds it for every reference. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Microsoft.AspNetCore.Server.HttpSys</AssemblyName>
    <RootNamespace>Microsoft.AspNetCore.Server.HttpSys</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyVersion>10.0.9999.0</AssemblyVersion>
    <FileVersion>10.0.9999.0</FileVersion>
    <Version>10.0.9999</Version>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>aspnetcore.publickey</AssemblyOriginatorKeyFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CA1416</NoWarn>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- the framework for Kestrel and hosting, kept to this project: what references it does not become a web app -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" PrivateAssets="all" />
    <!-- the shared port's forwarding (HttpSysPort.cs): YARP's forwarder, MIT -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <Target Name="WpfWebGpuShimsOnly" AfterTargets="ResolveTargetingPackAssets">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.AspNetCore.Server.HttpSys'" />
    </ItemGroup>
  </Target>

</Project>
